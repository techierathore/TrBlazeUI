# Auto detect text files and normalize line endings
* text=auto

# Force LF for files that are auto-generated or should be consistent
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Windows batch files need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - don't touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary


# TechieFlow — LF working tree on every platform (CRLF only where Windows demands it),
# and append-only telemetry logs that keep BOTH sides on merge.
# Managed by scaffold/update-framework.sh.
* text=auto eol=lf
docs/metrics/*.jsonl text eol=lf merge=union
