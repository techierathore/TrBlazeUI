<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TrBlazeUI.Demo.Auto</RootNamespace>
    <AssemblyName>TrBlazeUI.Demo.Auto</AssemblyName>
    <NoWarn>CS1591</NoWarn>
    <!-- Exclude nested client project from compilation -->
    <DefaultItemExcludes>$(DefaultItemExcludes);TrBlazeUI.Demo.Auto.Client\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrBlazeUI.Demo.Shared\TrBlazeUI.Demo.Shared.csproj" />
    <ProjectReference Include="TrBlazeUI.Demo.Auto.Client\TrBlazeUI.Demo.Auto.Client.csproj" />
  </ItemGroup>

</Project>
