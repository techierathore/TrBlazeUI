@inherits LayoutComponentBase
@using TrBlazeUI.Primitives.Services
@using TrBlazeUI.Components.Collapsible
@using TrBlazeUI.Components.Sidebar
@using TrBlazeUI.Components.Toast
@using TrBlazeUI.Components.Toolbar
@using TrBlazeUI.Components.DropdownMenu
@using TrBlazeUI.Components.Popover
@using TrBlazeUI.Icons.Lucide.Components

<PageTitle>TrBlazeUI Demo</PageTitle>

@if (objIsHorizontal)
{
    <!-- Horizontal Layout -->
    <div class="flex flex-col h-screen">
        <header class="flex h-16 shrink-0 items-center gap-4 border-b bg-background px-4 z-10">
            <a href="" class="flex items-center gap-2 shrink-0">
                <img src="_content/TrBlazeUI.Demo.Shared/images/b-icon-blueprint.png" alt="TrBlazeUI" class="size-7 rounded-lg" />
                <span class="font-semibold text-sm">TrBlazeUI</span>
            </a>

            <div class="flex-1 min-w-0">
                <HorizontalNav PrimitivesItems="@PrimitivesItems" ComponentsItems="@ComponentsItems" ChartsItems="@ChartsItems" IconsItems="@IconsItems" />
            </div>

            <div class="ml-auto flex items-center gap-2 shrink-0">
                <CommandSearch />
                <LayoutToggle />
                <DarkModeToggle />
            </div>
        </header>

        <!-- Document Manager Toolbar (horizontal layout only) -->
        <div class="shrink-0 border-b bg-muted/30 px-4 py-0">
            <Toolbar Variant="ToolbarVariant.Dense" AriaLabel="Document manager toolbar" Class="border-0 shadow-none bg-transparent rounded-none">
                <ToolbarGroup AriaLabel="File actions">
                    <ToolbarButton AriaLabel="New document" OnClick="@(e => OnToolbarAction("New Document"))">
                        <LucideIcon Name="file-plus" Size="16" />
                    </ToolbarButton>
                    <ToolbarButton AriaLabel="Open document" OnClick="@(e => OnToolbarAction("Open Document"))">
                        <LucideIcon Name="folder-open" Size="16" />
                    </ToolbarButton>
                    <ToolbarButton AriaLabel="Save" OnClick="@(e => OnToolbarAction("Save"))">
                        <LucideIcon Name="save" Size="16" />
                    </ToolbarButton>
                    <DropdownMenu>
                        <DropdownMenuTrigger>
                            <ToolbarButton AriaLabel="Save options">
                                <LucideIcon Name="chevron-down" Size="14" />
                            </ToolbarButton>
                        </DropdownMenuTrigger>
                        <DropdownMenuContent>
                            <DropdownMenuItem OnClick="@(() => OnToolbarAction("Save As..."))">
                                <LucideIcon Name="save" Size="16" Class="mr-1" />
                                Save As...
                            </DropdownMenuItem>
                            <DropdownMenuItem OnClick="@(() => OnToolbarAction("Save All"))">
                                <LucideIcon Name="save-all" Size="16" Class="mr-1" />
                                Save All
                            </DropdownMenuItem>
                            <DropdownMenuSeparator />
                            <DropdownMenuItem OnClick="@(() => OnToolbarAction("Export as PDF"))">
                                <LucideIcon Name="file-down" Size="16" Class="mr-1" />
                                Export as PDF
                            </DropdownMenuItem>
                        </DropdownMenuContent>
                    </DropdownMenu>
                    <ToolbarButton AriaLabel="Print" OnClick="@(e => OnToolbarAction("Print"))">
                        <LucideIcon Name="printer" Size="16" />
                    </ToolbarButton>
                </ToolbarGroup>
                <ToolbarSeparator />
                <ToolbarGroup AriaLabel="Edit actions">
                    <ToolbarButton AriaLabel="Undo" OnClick="@(e => OnToolbarAction("Undo"))">
                        <LucideIcon Name="undo-2" Size="16" />
                    </ToolbarButton>
                    <ToolbarButton AriaLabel="Redo" OnClick="@(e => OnToolbarAction("Redo"))">
                        <LucideIcon Name="redo-2" Size="16" />
                    </ToolbarButton>
                </ToolbarGroup>
                <ToolbarSeparator />
                <ToolbarGroup AriaLabel="Clipboard">
                    <ToolbarButton AriaLabel="Cut" OnClick="@(e => OnToolbarAction("Cut"))">
                        <LucideIcon Name="scissors" Size="16" />
                    </ToolbarButton>
                    <ToolbarButton AriaLabel="Copy" OnClick="@(e => OnToolbarAction("Copy"))">
                        <LucideIcon Name="copy" Size="16" />
                    </ToolbarButton>
                    <ToolbarButton AriaLabel="Paste" OnClick="@(e => OnToolbarAction("Paste"))">
                        <LucideIcon Name="clipboard-paste" Size="16" />
                    </ToolbarButton>
                </ToolbarGroup>
                <ToolbarSeparator />
                <ToolbarGroup AriaLabel="Text formatting">
                    <ToolbarToggleButton AriaLabel="Bold" IsPressed="objToolbarBold" IsPressedChanged="@(v => OnToolbarToggle("Bold", v, val => objToolbarBold = val))">
                        <LucideIcon Name="bold" Size="16" />
                    </ToolbarToggleButton>
                    <ToolbarToggleButton AriaLabel="Italic" IsPressed="objToolbarItalic" IsPressedChanged="@(v => OnToolbarToggle("Italic", v, val => objToolbarItalic = val))">
                        <LucideIcon Name="italic" Size="16" />
                    </ToolbarToggleButton>
                    <ToolbarToggleButton AriaLabel="Underline" IsPressed="objToolbarUnderline" IsPressedChanged="@(v => OnToolbarToggle("Underline", v, val => objToolbarUnderline = val))">
                        <LucideIcon Name="underline" Size="16" />
                    </ToolbarToggleButton>
                </ToolbarGroup>
                <ToolbarSeparator />
                <ToolbarGroup AriaLabel="Alignment">
                    <ToolbarButton AriaLabel="Align left" OnClick="@(e => OnToolbarAction("Align Left"))">
                        <LucideIcon Name="align-left" Size="16" />
                    </ToolbarButton>
                    <ToolbarButton AriaLabel="Align center" OnClick="@(e => OnToolbarAction("Align Center"))">
                        <LucideIcon Name="align-center" Size="16" />
                    </ToolbarButton>
                    <ToolbarButton AriaLabel="Align right" OnClick="@(e => OnToolbarAction("Align Right"))">
                        <LucideIcon Name="align-right" Size="16" />
                    </ToolbarButton>
                </ToolbarGroup>
                <ToolbarSeparator />
                <ToolbarGroup AriaLabel="Insert">
                    <ToolbarButton AriaLabel="Insert link" OnClick="@(e => OnToolbarAction("Insert Link"))">
                        <LucideIcon Name="link" Size="16" />
                    </ToolbarButton>
                    <ToolbarButton AriaLabel="Insert image" OnClick="@(e => OnToolbarAction("Insert Image"))">
                        <LucideIcon Name="image" Size="16" />
                    </ToolbarButton>
                    <ToolbarButton AriaLabel="Insert table" OnClick="@(e => OnToolbarAction("Insert Table"))">
                        <LucideIcon Name="table" Size="16" />
                    </ToolbarButton>
                </ToolbarGroup>
                <ToolbarSeparator />
                <ToolbarGroup AriaLabel="View">
                    <ToolbarButton AriaLabel="Zoom in" OnClick="@(e => OnToolbarAction("Zoom In"))">
                        <LucideIcon Name="zoom-in" Size="16" />
                    </ToolbarButton>
                    <ToolbarButton AriaLabel="Zoom out" OnClick="@(e => OnToolbarAction("Zoom Out"))">
                        <LucideIcon Name="zoom-out" Size="16" />
                    </ToolbarButton>
                    <ToolbarButton AriaLabel="Find" OnClick="@(e => OnToolbarAction("Find & Replace"))">
                        <LucideIcon Name="search" Size="16" />
                    </ToolbarButton>
                </ToolbarGroup>
            </Toolbar>
        </div>

        <div class="flex-1 overflow-auto p-6 md:p-8">
            @Body
        </div>
    </div>
}
else
{
    <!-- Vertical Sidebar Layout -->
    <SidebarProvider DefaultOpen="true" HeightClass="h-screen">
        <Sidebar Collapsible="true">
            <SidebarHeader>
                <SidebarMenu>
                    <SidebarMenuItem>
                        <SidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="" Size="@SidebarMenuButtonSize.Large" class="data-[state=collapsed]:justify-center">
                            <div class="flex aspect-square size-8 items-center justify-center rounded-lg">
                                <img src="_content/TrBlazeUI.Demo.Shared/images/b-icon-blueprint.png" alt="TrBlazeUI" class="size-8 rounded-lg" />
                            </div>
                            <div class="grid flex-1 text-left text-sm leading-tight">
                                <span class="truncate font-semibold">TrBlazeUI</span>
                            </div>
                        </SidebarMenuButton>
                    </SidebarMenuItem>
                </SidebarMenu>
            </SidebarHeader>

            <SidebarContent>
                <!-- Top-level Navigation -->
                <SidebarGroup>
                    <SidebarMenu>
                        <SidebarMenuItem>
                            <SidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="" Match="NavLinkMatch.All" Tooltip="Home">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                                <span>Home</span>
                            </SidebarMenuButton>
                        </SidebarMenuItem>

                        <SidebarMenuItem>
                            <SidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="whats-new" Tooltip="What's new">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 3v3"></path>
                                    <path d="m18.5 5.5-2.1 2.1"></path>
                                    <path d="M21 12h-3"></path>
                                    <path d="M6 12H3"></path>
                                    <path d="m7.6 7.6-2.1-2.1"></path>
                                    <circle cx="12" cy="14" r="5"></circle>
                                </svg>
                                <span>What's new</span>
                            </SidebarMenuButton>
                        </SidebarMenuItem>

                        <SidebarMenuItem>
                            <SidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="architecture" Tooltip="Architecture">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="16" height="20" x="4" y="2" rx="2"></rect>
                                    <path d="M8 6h8"></path>
                                    <path d="M8 10h8"></path>
                                    <path d="M8 14h5"></path>
                                </svg>
                                <span>Architecture</span>
                            </SidebarMenuButton>
                        </SidebarMenuItem>

                        <SidebarMenuItem>
                            <SidebarMenuButton AsChild="@SidebarMenuButtonElement.Anchor" Href="dynamic-theme" Tooltip="Dynamic Theme">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
                                    <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
                                    <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
                                    <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
                                    <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"></path>
                                </svg>
                                <span>Dynamic Theme</span>
                            </SidebarMenuButton>
                        </SidebarMenuItem>

                    </SidebarMenu>
                </SidebarGroup>

                <!-- Primitives Section -->
                <SidebarGroup>
                    <SidebarMenu>
                        <SidebarMenuItem>
                            <SidebarCollapsibleMenuItem Label="Primitives" Items="@PrimitivesItems" Open="@objPrimitivesMenuOpen" OpenChanged="@OnPrimitivesMenuOpenChanged">
                                <Icon>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                                        <path d="M9 3v18"></path>
                                    </svg>
                                </Icon>
                            </SidebarCollapsibleMenuItem>
                        </SidebarMenuItem>
                    </SidebarMenu>
                </SidebarGroup>

                <!-- Components Section -->
                <SidebarGroup>
                    <SidebarMenu>
                        <SidebarMenuItem>
                            <SidebarCollapsibleMenuItem Label="Components" Items="@ComponentsItems" Open="@objComponentsMenuOpen" OpenChanged="@OnComponentsMenuOpenChanged">
                                <Icon>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                                        <path d="M3 9h18"></path>
                                        <path d="M9 21V9"></path>
                                    </svg>
                                </Icon>
                            </SidebarCollapsibleMenuItem>
                        </SidebarMenuItem>
                    </SidebarMenu>
                </SidebarGroup>

                <!-- Charts Section -->
                <SidebarGroup>
                    <SidebarMenu>
                        <SidebarMenuItem>
                            <SidebarCollapsibleMenuItem Label="Charts" Items="@ChartsItems" Open="@objChartsMenuOpen" OpenChanged="@OnChartsMenuOpenChanged">
                                <Icon>
                                    <LucideIcon Name="bar-chart-3" Size="18" />
                                </Icon>
                            </SidebarCollapsibleMenuItem>
                        </SidebarMenuItem>
                    </SidebarMenu>
                </SidebarGroup>

                <!-- Icons Section -->
                <SidebarGroup>
                    <SidebarMenu>
                        <SidebarMenuItem>
                            <SidebarCollapsibleMenuItem Label="Icons" Items="@IconsItems" Open="@objIconsMenuOpen" OpenChanged="@OnIconsMenuOpenChanged">
                                <Icon>
                                    <LucideIcon Name="smile" Size="18" />
                                </Icon>
                            </SidebarCollapsibleMenuItem>
                        </SidebarMenuItem>
                    </SidebarMenu>
                </SidebarGroup>
            </SidebarContent>
        </Sidebar>

        <SidebarInset Class="overflow-hidden">
            <header class="flex h-16 shrink-0 items-center gap-4 border-b bg-background px-4 z-10 focus:outline-none">
                <SidebarTrigger />
                <div class="ml-auto flex items-center gap-2">
                    <CommandSearch />
                    <LayoutToggle />
                    <DarkModeToggle />
                </div>
            </header>

            <div class="flex-1 overflow-auto p-6 md:p-8">
                @Body
            </div>
        </SidebarInset>
    </SidebarProvider>
}

<ToastProvider Position="ToastPosition.BottomRight" />
<PortalHost />
