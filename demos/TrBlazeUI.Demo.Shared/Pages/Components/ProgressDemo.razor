@page "/components/progress"
@using TrBlazeUI.Components.Progress
@using TrBlazeUI.Components.Button
@using TrBlazeUI.Components.Separator

<PageTitle>Progress Component - TrBlazeUI</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">Progress Component</h1>
            <p class="text-xl text-muted-foreground">
                Displays an indicator showing the completion progress of a task.
            </p>
        </div>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Basic Example</h2>
            <p class="text-sm text-muted-foreground">
                A simple progress bar showing a static value.
            </p>
        </div>
        <Progress Value="33" />
    </div>

    <!-- Different Values -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Progress States</h2>
            <p class="text-sm text-muted-foreground">
                Progress bars at different completion levels.
            </p>
        </div>
        <div class="space-y-6">
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>Empty</span>
                    <span>0%</span>
                </div>
                <Progress Value="0" />
            </div>
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>Quarter</span>
                    <span>25%</span>
                </div>
                <Progress Value="25" />
            </div>
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>Half</span>
                    <span>50%</span>
                </div>
                <Progress Value="50" />
            </div>
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>Three Quarters</span>
                    <span>75%</span>
                </div>
                <Progress Value="75" />
            </div>
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>Complete</span>
                    <span>100%</span>
                </div>
                <Progress Value="100" />
            </div>
        </div>
    </div>

    <!-- Interactive Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Interactive Example</h2>
            <p class="text-sm text-muted-foreground">
                Control the progress value dynamically.
            </p>
        </div>
        <div class="space-y-4">
            <Progress Value="@objProgressValue" />
            <div class="flex items-center gap-4">
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => objProgressValue = Math.Max(0, objProgressValue - 10))">
                    -10
                </Button>
                <span class="text-sm font-medium w-12 text-center">@objProgressValue%</span>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => objProgressValue = Math.Min(100, objProgressValue + 10))">
                    +10
                </Button>
                <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="@(() => objProgressValue = 0)">
                    Reset
                </Button>
            </div>
        </div>
    </div>

    <!-- Custom Max Value -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Custom Max Value</h2>
            <p class="text-sm text-muted-foreground">
                Progress bars can have custom maximum values.
            </p>
        </div>
        <div class="space-y-4">
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>Downloaded 3 of 10 files</span>
                    <span>30%</span>
                </div>
                <Progress Value="3" Max="10" />
            </div>
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span>Uploaded 750MB of 1000MB</span>
                    <span>75%</span>
                </div>
                <Progress Value="750" Max="1000" />
            </div>
        </div>
    </div>

    <!-- Indeterminate -->
    <div class="space-y-4" data-testid="progress-indeterminate-section">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Indeterminate</h2>
            <p class="text-sm text-muted-foreground">
                Set <code class="text-xs bg-muted px-1 py-0.5 rounded">Indeterminate="true"</code> when work
                is under way with no known end. The bar animates without claiming a percentage:
                <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-valuenow</code> is omitted entirely,
                which is the ARIA signal that the value is unknown.
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Value</code> and
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Max</code> are ignored in this mode
                rather than fought over.
            </p>
        </div>
        <div class="space-y-6">
            <div class="space-y-2">
                <span class="text-sm">Indeterminate — no percentage claimed</span>
                <Progress Indeterminate="true" aria-label="Preparing your export" data-testid="progress-indeterminate" />
                <p class="text-xs text-muted-foreground">
                    Renders <code class="bg-muted px-1 py-0.5 rounded">role="progressbar"</code> with
                    <code class="bg-muted px-1 py-0.5 rounded">aria-valuemin="0"</code> and
                    <code class="bg-muted px-1 py-0.5 rounded">aria-valuemax="100"</code> (the ARIA defaults)
                    and <strong>no</strong> <code class="bg-muted px-1 py-0.5 rounded">aria-valuenow</code>.
                    Give it a name by splatting <code class="bg-muted px-1 py-0.5 rounded">aria-label</code>.
                </p>
            </div>
            <div class="space-y-2">
                <span class="text-sm">The same bar, determinate, for comparison</span>
                <Progress Value="40" aria-label="Export 40 percent complete" data-testid="progress-determinate" />
                <p class="text-xs text-muted-foreground">
                    Carries <code class="bg-muted px-1 py-0.5 rounded">aria-valuenow="40"</code>, exactly as before.
                    Nothing changes for existing callers when <strong>Indeterminate</strong> is left at its
                    <code class="bg-muted px-1 py-0.5 rounded">false</code> default.
                </p>
            </div>
            <div class="space-y-3">
                <span class="text-sm">Toggle one bar between the two modes</span>
                <Progress Indeterminate="@objIsIndeterminate" Value="65"
                          aria-label="Sample task" data-testid="progress-toggle-bar" />
                <div class="flex items-center gap-4">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                            data-testid="progress-indeterminate-toggle"
                            OnClick="@(() => objIsIndeterminate = !objIsIndeterminate)">
                        @(objIsIndeterminate ? "Show a percentage" : "Hide the percentage")
                    </Button>
                    <span class="text-sm text-muted-foreground" data-testid="progress-toggle-state">
                        @(objIsIndeterminate ? "Indeterminate — aria-valuenow absent" : "Determinate — aria-valuenow 65")
                    </span>
                </div>
                <p class="text-xs text-muted-foreground">
                    The bar keeps <code class="bg-muted px-1 py-0.5 rounded">Value</code> set the whole time.
                    While indeterminate that value is simply ignored, so flipping back restores the percentage
                    without the caller re-supplying it.
                </p>
            </div>
        </div>
        <div class="rounded-lg border p-4 text-sm text-muted-foreground">
            An indeterminate bar says "work is happening", not "your answer is being written". For text that
            is still being composed inside a message, use the
            <a href="/components/typing" class="text-primary underline underline-offset-2" data-testid="progress-typing-link">Typing</a>
            indicator instead — it sits inline in the sentence it belongs to.
        </div>
        <p class="text-xs text-muted-foreground">
            The travelling animation is dropped under
            <code class="bg-muted px-1 py-0.5 rounded">prefers-reduced-motion: reduce</code>; the bar then
            fades slowly in place instead of moving.
        </p>
    </div>

    <!-- Custom Styling -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Custom Styling</h2>
            <p class="text-sm text-muted-foreground">
                Override styles with custom classes.
            </p>
        </div>
        <div class="space-y-4">
            <div class="space-y-2">
                <span class="text-sm">Taller progress bar</span>
                <Progress Value="60" Class="h-6" />
            </div>
            <div class="space-y-2">
                <span class="text-sm">Custom colors</span>
                <Progress Value="80" Class="bg-blue-100 dark:bg-blue-900" IndicatorClass="bg-blue-500" />
            </div>
            <div class="space-y-2">
                <span class="text-sm">Rounded full</span>
                <Progress Value="45" Class="h-3 rounded-full" />
            </div>
        </div>
    </div>

    <!-- API Reference -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">API Reference</h2>
        </div>
        <div class="border rounded-lg p-6 space-y-4">
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Value</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">double</code>
                </p>
                <p class="text-sm text-muted-foreground">
                    The current progress value. Default: 0. Ignored when <strong>Indeterminate</strong> is true.
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Max</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">double</code>
                </p>
                <p class="text-sm text-muted-foreground">
                    The maximum value. Default: 100. Ignored when <strong>Indeterminate</strong> is true.
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Indeterminate</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code>
                </p>
                <p class="text-sm text-muted-foreground">
                    Whether the bar shows work under way with no known end. Default: false.
                    When true the bar animates, <strong>Value</strong> and <strong>Max</strong> are ignored,
                    and <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-valuenow</code> is omitted so
                    assistive technology reports the value as unknown.
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Class</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code>
                </p>
                <p class="text-sm text-muted-foreground">
                    Additional CSS classes for the progress container.
                </p>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">IndicatorClass</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code>
                </p>
                <p class="text-sm text-muted-foreground">
                    Additional CSS classes for the progress indicator.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private double objProgressValue = 33;
    private bool objIsIndeterminate;
}
