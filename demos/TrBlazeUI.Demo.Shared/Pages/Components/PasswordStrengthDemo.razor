@page "/components/password-strength"
@using TrBlazeUI.Components.PasswordStrength
@using TrBlazeUI.Components.Input
@using TrBlazeUI.Components.Field

<PageTitle>Password Strength Component - TrBlazeUI</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">Password Strength</h1>
        <p class="text-xl text-muted-foreground">
            A live strength meter for a password field, scored on length and character variety.
        </p>
    </div>

    <div class="rounded-lg border border-alert-info bg-alert-info-bg p-4 text-sm text-alert-info-foreground">
        The score is announced as text through an <code>aria-live="polite"</code> region and the bar
        itself is <code>aria-hidden</code> — strength is never conveyed by colour alone.
    </div>

    <!-- Live -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Basic Example</h2>
            <p class="text-sm text-muted-foreground">Type a password to watch the meter move.</p>
        </div>
        <div class="max-w-sm space-y-2 rounded-lg border p-6">
            <Field>
                <FieldLabel For="pw-demo">Choose a password</FieldLabel>
                <FieldContent>
                    <Input Id="pw-demo" Type="InputType.Password" @bind-Value="objPassword"
                           Placeholder="At least 8 characters" />
                </FieldContent>
            </Field>
            <PasswordStrength Value="@objPassword" LevelChanged="@(level => objLevel = level)" />
            <p class="text-xs text-muted-foreground">Current level: <strong>@objLevel</strong></p>
        </div>
    </div>

    <!-- Levels -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">The five levels</h2>
            <p class="text-sm text-muted-foreground">
                <code>Empty</code>, <code>Weak</code>, <code>Fair</code>, <code>Good</code>,
                <code>Strong</code>. Anything shorter than <code>MinimumLength</code> can never score
                above Weak, however varied it is.
            </p>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
            @foreach (var vSample in objSamples)
            {
                <div class="space-y-1 rounded-lg border p-4">
                    <p class="font-mono text-sm">@(string.IsNullOrEmpty(vSample) ? "(empty)" : vSample)</p>
                    <PasswordStrength Value="@vSample" />
                </div>
            }
        </div>
    </div>

    <!-- MinimumLength -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">MinimumLength</h2>
            <p class="text-sm text-muted-foreground">
                Raise it to make your own policy the floor. The same password scored against 8 and 16.
            </p>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
            <div class="space-y-1 rounded-lg border p-4">
                <p class="text-xs font-semibold text-muted-foreground">MinimumLength="8"</p>
                <p class="font-mono text-sm">Tr0ub4dor&amp;3</p>
                <PasswordStrength Value="Tr0ub4dor&3" MinimumLength="8" />
            </div>
            <div class="space-y-1 rounded-lg border p-4">
                <p class="text-xs font-semibold text-muted-foreground">MinimumLength="16"</p>
                <p class="font-mono text-sm">Tr0ub4dor&amp;3</p>
                <PasswordStrength Value="Tr0ub4dor&3" MinimumLength="16" />
            </div>
        </div>
    </div>

    <!-- Usage -->
    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">Usage</h2>
        <pre class="overflow-x-auto rounded-lg border bg-muted/30 p-4 text-sm"><code>@objUsage</code></pre>
    </div>
</div>

@code {
    private string? objPassword;
    private PasswordStrengthLevel objLevel = PasswordStrengthLevel.Empty;

    private readonly string[] objSamples = ["", "pass", "password1", "Password1", "P@ssword1!x"];

    private const string objUsage = """
        @using TrBlazeUI.Components.PasswordStrength

        <Input Type="InputType.Password" @bind-Value="password" />
        <PasswordStrength Value="@password" MinimumLength="8"
                          LevelChanged="@(level => strength = level)" />

        @* The scoring function is also usable on its own, for server-side validation: *@
        @code {
            private bool IsAcceptable(string value) =>
                PasswordStrength.Evaluate(value) >= PasswordStrengthLevel.Good;
        }
        """;
}
