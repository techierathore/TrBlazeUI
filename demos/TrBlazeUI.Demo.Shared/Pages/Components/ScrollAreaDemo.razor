@page "/components/scroll-area"
@using TrBlazeUI.Components.ScrollArea
@using TrBlazeUI.Components.Separator
@using TrBlazeUI.Components.CodeBlock
@implements IDisposable

<PageTitle>Scroll Area Component - TrBlazeUI</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">Scroll Area Component</h1>
            <p class="text-xl text-muted-foreground">
                Augments native scroll functionality with custom styling.
            </p>
        </div>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Basic Example</h2>
            <p class="text-sm text-muted-foreground">
                A scrollable area with vertical scrolling.
            </p>
        </div>
        <ScrollArea Height="200px" Class="w-[350px] rounded-md border p-4">
            <div class="space-y-4">
                <h4 class="text-sm font-medium leading-none">Tags</h4>
                @foreach (var tag in objTags)
                {
                    <div class="text-sm">@tag</div>
                    <Separator />
                }
            </div>
        </ScrollArea>
    </div>

    <!-- Horizontal Scrolling -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Horizontal Scrolling</h2>
            <p class="text-sm text-muted-foreground">
                A scrollable area with horizontal scrolling.
            </p>
        </div>
        <ScrollArea Orientation="ScrollAreaOrientation.Horizontal" Class="w-full whitespace-nowrap rounded-md border">
            <div class="flex w-max space-x-4 p-4">
                @for (int i = 1; i <= 10; i++)
                {
                    <div class="shrink-0">
                        <div class="overflow-hidden rounded-md">
                            <div class="h-[150px] w-[250px] bg-muted flex items-center justify-center">
                                <span class="text-2xl font-semibold">Image @i</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </ScrollArea>
    </div>

    <!-- Long Content -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Long Content</h2>
            <p class="text-sm text-muted-foreground">
                Scroll area with extensive content.
            </p>
        </div>
        <ScrollArea MaxHeight="300px" Class="w-[350px] rounded-md border p-4">
            <div class="space-y-4">
                <h4 class="text-sm font-medium leading-none mb-4">Lorem Ipsum</h4>
                @for (int i = 0; i < 5; i++)
                {
                    <p class="text-sm text-muted-foreground">
                        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
                    </p>
                }
            </div>
        </ScrollArea>
    </div>

    <!-- Stick To End -->
    <div class="space-y-4" data-testid="stick-to-end-section">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Stick To End</h2>
            <p class="text-sm text-muted-foreground">
                <code class="bg-muted px-1 py-0.5 rounded">StickToEnd</code> keeps a growing log at its newest line.
                Scroll up to read and following stops; scroll back to the bottom, or press Jump to latest, and it resumes.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <Button Size="ButtonSize.Small" OnClick="ToggleBuild" data-testid="stick-to-end-toggle">@(objTimer == null ? "Start build" : "Stop build")</Button>
            <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="AddLine" data-testid="stick-to-end-add">Add one line</Button>
            @if (!objIsAtEnd)
            {
                <Button Size="ButtonSize.Small" Variant="ButtonVariant.Secondary" OnClick="JumpToLatest" data-testid="stick-to-end-jump">Jump to latest</Button>
            }
            <span class="text-sm text-muted-foreground" data-testid="stick-to-end-state">@(objIsAtEnd ? "Following" : "Paused - reading older lines")</span>
        </div>
        <ScrollArea @ref="objLogArea" StickToEnd="true" AtEndChanged="OnAtEndChanged"
                    Class="h-[240px] w-full rounded-md border" data-testid="stick-to-end-area">
            <CodeBlock Code="@objOutput" Language="build" ShowCopyButton="false" Class="rounded-none border-0" />
        </ScrollArea>
    </div>

    <!-- API Reference -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">API Reference</h2>
        </div>
        <div class="border rounded-lg p-6 space-y-4">
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">ScrollArea Parameters</h3>
                <div class="space-y-2 text-sm">
                    <p><strong>Orientation:</strong> <code class="bg-muted px-1 py-0.5 rounded">ScrollAreaOrientation</code> - Vertical (default), Horizontal, or Both</p>
                    <p><strong>Type:</strong> <code class="bg-muted px-1 py-0.5 rounded">ScrollAreaType</code> - Auto, Always, Hover, or Hidden</p>
                    <p><strong>Height:</strong> <code class="bg-muted px-1 py-0.5 rounded">string</code> - Fixed height (e.g., "200px")</p>
                    <p><strong>MaxHeight:</strong> <code class="bg-muted px-1 py-0.5 rounded">string</code> - Maximum height (e.g., "300px")</p>
                    <p><strong>StickToEnd:</strong> <code class="bg-muted px-1 py-0.5 rounded">bool</code> - Follow new content until the reader scrolls away; resume at the end</p>
                    <p><strong>AtEndChanged:</strong> <code class="bg-muted px-1 py-0.5 rounded">EventCallback&lt;bool&gt;</code> - Raised when following stops (false) or resumes (true)</p>
                    <p><strong>ScrollToEndAsync():</strong> <code class="bg-muted px-1 py-0.5 rounded">Task</code> - Scrolls to the end and resumes following</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ScrollArea? objLogArea;
    private System.Threading.Timer? objTimer;
    private bool objIsAtEnd = true;
    private int objLineCount;
    private string objOutput = "$ build started";

    private void AddLine()
    {
        objLineCount++;
        objOutput += $"\n[{objLineCount:D3}] Compiling step {objLineCount} of 200 ... ok";
    }

    private void ToggleBuild()
    {
        if (objTimer != null)
        {
            objTimer.Dispose();
            objTimer = null;
            return;
        }

        objTimer = new System.Threading.Timer(aState => InvokeAsync(() =>
        {
            AddLine();
            StateHasChanged();
        }), null, 0, 250);
    }

    private void OnAtEndChanged(bool aIsAtEnd) => objIsAtEnd = aIsAtEnd;

    private async Task JumpToLatest()
    {
        if (objLogArea != null)
        {
            await objLogArea.ScrollToEndAsync();
        }
    }

    /// <inheritdoc />
    public void Dispose() => objTimer?.Dispose();

    private readonly string[] objTags = new[]
    {
        "React", "Vue", "Angular", "Svelte", "Blazor",
        "Next.js", "Nuxt", "Gatsby", "Remix", "Astro",
        "TypeScript", "JavaScript", "C#", "Python", "Go"
    };
}
