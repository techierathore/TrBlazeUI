@page "/components/menubar"
@using TrBlazeUI.Components.Menubar
@using TrBlazeUI.Components.Separator
@using TrBlazeUI.Components.Kbd
@using TrBlazeUI.Primitives.Services
@inject IKeyboardShortcutService KeyboardShortcuts
@implements IAsyncDisposable

<PageTitle>Menubar Component - TrBlazeUI</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">Menubar Component</h1>
            <p class="text-xl text-muted-foreground">
                A visually persistent menu common in desktop applications.
            </p>
        </div>
    </div>

    <!-- Example with Keyboard Shortcuts -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Example</h2>
            <p class="text-sm text-muted-foreground">
                A menubar with working keyboard shortcuts. Press shortcuts anywhere on the page - they work even when menus are closed.
            </p>
        </div>

        <div class="flex items-start gap-4">
            <Menubar>
                <MenubarMenu>
                    <MenubarTrigger>File</MenubarTrigger>
                    <MenubarContent>
                        <MenubarItem OnClick="@(() => HandleShortcutAction("New Tab"))">
                            New Tab
                            <MenubarShortcut>Ctrl+Shift+T</MenubarShortcut>
                        </MenubarItem>
                        <MenubarItem OnClick="@(() => HandleShortcutAction("New Window"))">
                            New Window
                            <MenubarShortcut>Ctrl+Shift+N</MenubarShortcut>
                        </MenubarItem>
                        <MenubarSeparator />
                        <MenubarItem OnClick="@(() => HandleShortcutAction("Share"))">Share</MenubarItem>
                        <MenubarSeparator />
                        <MenubarItem OnClick="@(() => HandleShortcutAction("Print"))">
                            Print...
                            <MenubarShortcut>Ctrl+Shift+P</MenubarShortcut>
                        </MenubarItem>
                    </MenubarContent>
                </MenubarMenu>
                <MenubarMenu>
                    <MenubarTrigger>Edit</MenubarTrigger>
                    <MenubarContent>
                        <MenubarItem OnClick="@(() => HandleShortcutAction("Undo"))">
                            Undo
                            <MenubarShortcut>Ctrl+Z</MenubarShortcut>
                        </MenubarItem>
                        <MenubarItem OnClick="@(() => HandleShortcutAction("Redo"))">
                            Redo
                            <MenubarShortcut>Ctrl+Y</MenubarShortcut>
                        </MenubarItem>
                        <MenubarSeparator />
                        <MenubarItem OnClick="@(() => HandleShortcutAction("Find"))">
                            Find
                            <MenubarShortcut>Ctrl+F</MenubarShortcut>
                        </MenubarItem>
                        <MenubarItem OnClick="@(() => HandleShortcutAction("Replace"))">
                            Replace
                            <MenubarShortcut>Ctrl+H</MenubarShortcut>
                        </MenubarItem>
                    </MenubarContent>
                </MenubarMenu>
                <MenubarMenu>
                    <MenubarTrigger>View</MenubarTrigger>
                    <MenubarContent>
                        <MenubarLabel>Appearance</MenubarLabel>
                        <MenubarCheckboxItem @bind-Checked="objShowStatusBar">Status Bar</MenubarCheckboxItem>
                        <MenubarCheckboxItem @bind-Checked="objShowActivityBar">Activity Bar</MenubarCheckboxItem>
                        <MenubarCheckboxItem @bind-Checked="objShowSidebar">Sidebar</MenubarCheckboxItem>
                        <MenubarSeparator />
                        <MenubarLabel>Zoom</MenubarLabel>
                        <MenubarItem OnClick="@(() => HandleShortcutAction("Zoom In"))">
                            Zoom In
                            <MenubarShortcut>Ctrl+=</MenubarShortcut>
                        </MenubarItem>
                        <MenubarItem OnClick="@(() => HandleShortcutAction("Zoom Out"))">
                            Zoom Out
                            <MenubarShortcut>Ctrl+-</MenubarShortcut>
                        </MenubarItem>
                        <MenubarSeparator />
                        <MenubarCheckboxItem @bind-Checked="objFullScreen">Full Screen</MenubarCheckboxItem>
                    </MenubarContent>
                </MenubarMenu>
                <MenubarMenu>
                    <MenubarTrigger>Help</MenubarTrigger>
                    <MenubarContent>
                        <MenubarItem OnClick="@(() => HandleShortcutAction("Documentation"))">
                            Documentation
                            <MenubarShortcut>F1</MenubarShortcut>
                        </MenubarItem>
                        <MenubarSeparator />
                        <MenubarItem OnClick="@(() => HandleShortcutAction("About"))">About</MenubarItem>
                    </MenubarContent>
                </MenubarMenu>
            </Menubar>

            @if (!string.IsNullOrEmpty(objShortcutAction))
            {
                <div class="flex items-center gap-2 p-3 bg-primary/10 text-primary rounded-md animate-pulse">
                    <LucideIcon Name="check-circle" Size="16" />
                    <span>Shortcut triggered: <strong>@objShortcutAction</strong></span>
                </div>
            }
        </div>

        <div class="mt-4 p-4 bg-muted rounded-lg">
            <p class="font-medium mb-3">Available shortcuts:</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-sm">
                <div class="flex items-center gap-2">
                    <Kbd Keys="Ctrl+Shift+T" Size="KbdSize.Small" /> <span class="text-muted-foreground">New Tab</span>
                </div>
                <div class="flex items-center gap-2">
                    <Kbd Keys="Ctrl+Shift+N" Size="KbdSize.Small" /> <span class="text-muted-foreground">New Window</span>
                </div>
                <div class="flex items-center gap-2">
                    <Kbd Keys="Ctrl+Z" Size="KbdSize.Small" /> <span class="text-muted-foreground">Undo</span>
                </div>
                <div class="flex items-center gap-2">
                    <Kbd Keys="Ctrl+Y" Size="KbdSize.Small" /> <span class="text-muted-foreground">Redo</span>
                </div>
                <div class="flex items-center gap-2">
                    <Kbd Keys="Ctrl+F" Size="KbdSize.Small" /> <span class="text-muted-foreground">Find</span>
                </div>
                <div class="flex items-center gap-2">
                    <Kbd Keys="Ctrl+H" Size="KbdSize.Small" /> <span class="text-muted-foreground">Replace</span>
                </div>
                <div class="flex items-center gap-2">
                    <Kbd Keys="F1" Size="KbdSize.Small" /> <span class="text-muted-foreground">Documentation</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Submenus and disabled items (Chatur TR-020, TR-021) -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Submenus and disabled items</h2>
            <p class="text-sm text-muted-foreground">
                A row with a ▸ opens a second list beside it. Hover or click it, or press ArrowRight on it;
                ArrowLeft or Escape closes the list and puts the focus back on the row. Submenus nest:
                File ▸ Recent projects ▸ More ▸ is three levels deep. Save, Redo and Word wrap are
                disabled and say so to a screen reader.
            </p>
        </div>

        <div class="flex flex-wrap items-start gap-4">
            <Menubar data-testid="menubar-sub-demo">
                <MenubarMenu>
                    <MenubarTrigger data-testid="menubar-sub-file">File</MenubarTrigger>
                    <MenubarContent>
                        <MenubarItem OnClick="@(() => objSubChoice = "New project")">New project</MenubarItem>
                        <MenubarSub>
                            <MenubarSubTrigger data-testid="menubar-sub-recent">Recent projects</MenubarSubTrigger>
                            <MenubarSubContent data-testid="menubar-sub-recent-list">
                                <MenubarItem OnClick="@(() => objSubChoice = "Chatur")">Chatur</MenubarItem>
                                <MenubarItem OnClick="@(() => objSubChoice = "Lekhak")">Lekhak</MenubarItem>
                                <MenubarSeparator />
                                <MenubarSub>
                                    <MenubarSubTrigger data-testid="menubar-sub-more">More</MenubarSubTrigger>
                                    <MenubarSubContent data-testid="menubar-sub-more-list">
                                        <MenubarItem OnClick="@(() => objSubChoice = "Sevak")" data-testid="menubar-sub-sevak">Sevak</MenubarItem>
                                        <MenubarItem OnClick="@(() => objSubChoice = "TfLens")">TfLens</MenubarItem>
                                    </MenubarSubContent>
                                </MenubarSub>
                            </MenubarSubContent>
                        </MenubarSub>
                        <MenubarSeparator />
                        <MenubarItem Disabled="true" data-testid="menubar-sub-save">
                            Save
                            <MenubarShortcut>Ctrl+S</MenubarShortcut>
                        </MenubarItem>
                    </MenubarContent>
                </MenubarMenu>
                <MenubarMenu>
                    <MenubarTrigger>Edit</MenubarTrigger>
                    <MenubarContent>
                        <MenubarItem OnClick="@(() => objSubChoice = "Undo")">Undo</MenubarItem>
                        <MenubarItem Disabled="true" data-testid="menubar-sub-redo">Redo</MenubarItem>
                    </MenubarContent>
                </MenubarMenu>
                <MenubarMenu>
                    <MenubarTrigger data-testid="menubar-sub-view">View</MenubarTrigger>
                    <MenubarContent>
                        <MenubarCheckboxItem @bind-Checked="objMinimap">Minimap</MenubarCheckboxItem>
                        <MenubarCheckboxItem Disabled="true" data-testid="menubar-sub-wrap">Word wrap</MenubarCheckboxItem>
                        <MenubarSeparator />
                        <MenubarSub>
                            <MenubarSubTrigger data-testid="menubar-sub-zoom">Zoom</MenubarSubTrigger>
                            <MenubarSubContent data-testid="menubar-sub-zoom-list">
                                <MenubarItem OnClick="@(() => objSubChoice = "Zoom in")">Zoom in</MenubarItem>
                                <MenubarItem OnClick="@(() => objSubChoice = "Zoom out")">Zoom out</MenubarItem>
                                <MenubarItem OnClick="@(() => objSubChoice = "Reset zoom")">Reset zoom</MenubarItem>
                            </MenubarSubContent>
                        </MenubarSub>
                    </MenubarContent>
                </MenubarMenu>
            </Menubar>

            <p class="text-sm text-muted-foreground" data-testid="menubar-sub-choice">
                Chosen: <strong>@(objSubChoice ?? "nothing yet")</strong>
            </p>
        </div>

        <pre class="overflow-x-auto rounded-md bg-muted p-4 text-xs"><code>@SubSample</code></pre>
    </div>

    <!-- API Reference -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">API Reference</h2>
        </div>
        <div class="border rounded-lg p-6 space-y-4">
            <div>
                <h3 class="font-semibold mb-2">Components</h3>
                <div class="space-y-2 text-sm">
                    <p><code class="bg-muted px-1 py-0.5 rounded">Menubar</code> - Root container</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">MenubarMenu</code> - Individual menu</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">MenubarTrigger</code> - Menu button</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">MenubarContent</code> - Dropdown content</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">MenubarItem</code> - Menu item</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">MenubarCheckboxItem</code> - Toggleable menu item</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">MenubarLabel</code> - Section label</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">MenubarSeparator</code> - Visual divider</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">MenubarShortcut</code> - Keyboard shortcut hint</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">MenubarSub</code> - Submenu: holds a trigger row and its list; nests to any depth</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">MenubarSubTrigger</code> - Row that opens the submenu, with a ▸ at its right</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">MenubarSubContent</code> - The list beside the row</p>
                </div>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">MenubarSubTrigger Parameters</h3>
                <div class="space-y-2 text-sm">
                    <p><strong>Disabled:</strong> <code class="bg-muted px-1 py-0.5 rounded">bool</code> - The row cannot open its list</p>
                    <p><strong>Inset:</strong> <code class="bg-muted px-1 py-0.5 rounded">bool</code> - Adds left padding</p>
                    <p><strong>Chevron:</strong> <code class="bg-muted px-1 py-0.5 rounded">RenderFragment</code> - The mark at the right of the row; defaults to ▸</p>
                </div>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">MenubarItem Parameters</h3>
                <div class="space-y-2 text-sm">
                    <p><strong>OnClick:</strong> <code class="bg-muted px-1 py-0.5 rounded">EventCallback</code> - Click handler</p>
                    <p><strong>Disabled:</strong> <code class="bg-muted px-1 py-0.5 rounded">bool</code> - Disables the item; renders aria-disabled="true" and data-disabled</p>
                    <p><strong>Inset:</strong> <code class="bg-muted px-1 py-0.5 rounded">bool</code> - Adds left padding</p>
                </div>
            </div>
            <Separator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">MenubarCheckboxItem Parameters</h3>
                <div class="space-y-2 text-sm">
                    <p><strong>Checked:</strong> <code class="bg-muted px-1 py-0.5 rounded">bool</code> - Whether the item is checked</p>
                    <p><strong>CheckedChanged:</strong> <code class="bg-muted px-1 py-0.5 rounded">EventCallback&lt;bool&gt;</code> - Callback when checked state changes</p>
                    <p><strong>Disabled:</strong> <code class="bg-muted px-1 py-0.5 rounded">bool</code> - Disables the item</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? objShortcutAction;

    // View menu checkbox states
    private bool objShowStatusBar = true;
    private bool objShowActivityBar = true;
    private bool objShowSidebar = false;
    private bool objFullScreen = false;

    // Submenus and disabled items section
    private string? objSubChoice;
    private bool objMinimap = true;

    private const string SubSample = """
        <MenubarMenu>
            <MenubarTrigger>File</MenubarTrigger>
            <MenubarContent>
                <MenubarSub>
                    <MenubarSubTrigger>Recent projects</MenubarSubTrigger>
                    <MenubarSubContent>
                        <MenubarItem OnClick="OpenChatur">Chatur</MenubarItem>
                        <MenubarSub>
                            <MenubarSubTrigger>More</MenubarSubTrigger>
                            <MenubarSubContent>
                                <MenubarItem OnClick="OpenSevak">Sevak</MenubarItem>
                            </MenubarSubContent>
                        </MenubarSub>
                    </MenubarSubContent>
                </MenubarSub>
                <MenubarItem Disabled="true">Save</MenubarItem>
            </MenubarContent>
        </MenubarMenu>
        """;

    // Keyboard shortcut registrations
    private IDisposable? objShortcutNewTab;
    private IDisposable? objShortcutNewWindow;
    private IDisposable? objShortcutPrint;
    private IDisposable? objShortcutUndo;
    private IDisposable? objShortcutRedo;
    private IDisposable? objShortcutFind;
    private IDisposable? objShortcutReplace;
    private IDisposable? objShortcutDocs;
    private CancellationTokenSource? objClearCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Register keyboard shortcuts
            objShortcutNewTab = await KeyboardShortcuts.RegisterAsync("Ctrl+Shift+T", () => HandleShortcutAsync("New Tab"));
            objShortcutNewWindow = await KeyboardShortcuts.RegisterAsync("Ctrl+Shift+N", () => HandleShortcutAsync("New Window"));
            objShortcutPrint = await KeyboardShortcuts.RegisterAsync("Ctrl+Shift+P", () => HandleShortcutAsync("Print"));
            objShortcutUndo = await KeyboardShortcuts.RegisterAsync("Ctrl+Z", () => HandleShortcutAsync("Undo"));
            objShortcutRedo = await KeyboardShortcuts.RegisterAsync("Ctrl+Y", () => HandleShortcutAsync("Redo"));
            objShortcutFind = await KeyboardShortcuts.RegisterAsync("Ctrl+F", () => HandleShortcutAsync("Find"));
            objShortcutReplace = await KeyboardShortcuts.RegisterAsync("Ctrl+H", () => HandleShortcutAsync("Replace"));
            objShortcutDocs = await KeyboardShortcuts.RegisterAsync("F1", () => HandleShortcutAsync("Documentation"));
        }
    }

    private async Task HandleShortcutAsync(string action)
    {
        objShortcutAction = action;
        await InvokeAsync(StateHasChanged);

        // Cancel any previous clear timer
        objClearCts?.Cancel();
        objClearCts = new CancellationTokenSource();

        // Clear after 2 seconds
        try
        {
            await Task.Delay(2000, objClearCts.Token);
            objShortcutAction = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
            // Timer was cancelled, ignore
        }
    }

    private void HandleShortcutAction(string action)
    {
        _ = HandleShortcutAsync(action);
    }

    public ValueTask DisposeAsync()
    {
        objClearCts?.Cancel();
        objClearCts?.Dispose();
        objShortcutNewTab?.Dispose();
        objShortcutNewWindow?.Dispose();
        objShortcutPrint?.Dispose();
        objShortcutUndo?.Dispose();
        objShortcutRedo?.Dispose();
        objShortcutFind?.Dispose();
        objShortcutReplace?.Dispose();
        objShortcutDocs?.Dispose();
        return ValueTask.CompletedTask;
    }
}
