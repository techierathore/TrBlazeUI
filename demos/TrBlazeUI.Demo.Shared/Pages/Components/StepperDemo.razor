@page "/components/stepper"
@using TrBlazeUI.Components.Stepper
@using TrBlazeUI.Components.Button
@using TrBlazeUI.Components.Badge

<PageTitle>Stepper Component - TrBlazeUI</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">Stepper</h1>
        <p class="text-xl text-muted-foreground">
            Numbered steps for a multi-part flow, a checkout, or a series index.
        </p>
    </div>

    <div class="rounded-lg border border-alert-info bg-alert-info-bg p-4 text-sm text-alert-info-foreground">
        The current step carries <code>aria-current="step"</code> and an <code>sr-only</code>
        "(current step)" label, so its position is not signalled by colour alone (WCAG 1.4.1).
    </div>

    <!-- Interactive -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Basic Example</h2>
            <p class="text-sm text-muted-foreground">
                Steps number themselves in declaration order; <code>Current</code> is 1-based.
            </p>
        </div>
        <div class="space-y-4 rounded-lg border p-6">
            <Stepper Current="@objCurrent" AriaLabel="Publishing progress">
                <StepperItem Title="Draft" Description="Write the post" />
                <StepperItem Title="Review" Description="Editor sign-off" />
                <StepperItem Title="Schedule" Description="Pick a date" />
                <StepperItem Title="Publish" />
            </Stepper>
            <div class="flex gap-2">
                <Button Variant="ButtonVariant.Outline" Disabled="@(objCurrent <= 1)"
                        OnClick="@(() => objCurrent--)">Back</Button>
                <Button Disabled="@(objCurrent >= 4)" OnClick="@(() => objCurrent++)">Next</Button>
                <span class="self-center text-sm text-muted-foreground">Step @objCurrent of 4</span>
            </div>
        </div>
    </div>

    <!-- Vertical -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Vertical</h2>
            <p class="text-sm text-muted-foreground">
                <code>Orientation="StepperOrientation.Vertical"</code> stacks the steps, which suits
                a sidebar or a narrow viewport.
            </p>
        </div>
        <div class="rounded-lg border p-6">
            <Stepper Current="2" Orientation="StepperOrientation.Vertical" AriaLabel="Onboarding">
                <StepperItem Title="Create your account" Description="Email and password" />
                <StepperItem Title="Verify your email" Description="We sent you a link" />
                <StepperItem Title="Set up your profile" />
            </Stepper>
        </div>
    </div>

    <!-- Per-step status -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">A step that carries its own state</h2>
            <p class="text-sm text-muted-foreground">
                <code>Current</code> alone can only say "everything before here worked". A real
                pipeline pauses, retries and fails, so each step can set its own
                <code>Status</code> — <code>Pending</code>, <code>Running</code>,
                <code>Waiting</code>, <code>Done</code>, <code>Retried</code> or
                <code>Failed</code>. <code>Trailing</code> puts content at the step's far edge.
                Leave <code>Status</code> unset and the step behaves exactly as it always has.
            </p>
        </div>
        <div class="rounded-lg border p-6">
            <Stepper Current="3" Orientation="StepperOrientation.Vertical" AriaLabel="Release pipeline">
                <StepperItem Title="Checkout" Description="Fetched the tag" Status="StepStatus.Done"
                             data-testid="step-done">
                    <Trailing><Badge Variant="BadgeVariant.Secondary">4s</Badge></Trailing>
                </StepperItem>
                <StepperItem Title="Restore" Description="Succeeded on the second try"
                             Status="StepStatus.Retried" data-testid="step-retried">
                    <Trailing><Badge Variant="BadgeVariant.Secondary">1m 12s</Badge></Trailing>
                </StepperItem>
                <StepperItem Title="Build" Description="Compiling the solution" Status="StepStatus.Running"
                             data-testid="step-running">
                    <Trailing><Badge Variant="BadgeVariant.Secondary">running</Badge></Trailing>
                </StepperItem>
                <StepperItem Title="Sign" Description="Waiting for the release approval"
                             Status="StepStatus.Waiting" data-testid="step-waiting" />
                <StepperItem Title="Publish" Description="The feed rejected the package"
                             Status="StepStatus.Failed" data-testid="step-failed" />
                <StepperItem Title="Announce" Status="StepStatus.Pending" data-testid="step-pending" />
            </Stepper>
        </div>
        <div class="rounded-lg border border-alert-info bg-alert-info-bg p-4 text-sm text-alert-info-foreground">
            Each marker is a <code>role="img"</code> with its status as the accessible name
            ("Failed"), and each status has its own glyph as well as its own colour — so the state
            survives a greyscale screen and a screen reader alike (WCAG 1.4.1). The stepper's
            <code>Current</code> is still 3, so <code>aria-current="step"</code> lands on
            <strong>Build</strong> no matter what the other steps report.
        </div>
    </div>

    <!-- Series index -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">As a series index</h2>
            <p class="text-sm text-muted-foreground">
                Child content renders under the label, so each step can carry a link.
            </p>
        </div>
        <div class="rounded-lg border p-6">
            <Stepper Current="2" Orientation="StepperOrientation.Vertical" AriaLabel="Series parts">
                <StepperItem Title="Part 1 — Primitives">
                    <a href="/primitives" class="text-sm text-primary">Read part 1</a>
                </StepperItem>
                <StepperItem Title="Part 2 — Styled components">
                    <a href="/components" class="text-sm text-primary">Read part 2</a>
                </StepperItem>
                <StepperItem Title="Part 3 — Theming">
                    <a href="/dynamic-theme" class="text-sm text-primary">Read part 3</a>
                </StepperItem>
            </Stepper>
        </div>
    </div>

    <!-- Usage -->
    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">Usage</h2>
        <pre class="overflow-x-auto rounded-lg border bg-muted/30 p-4 text-sm"><code>@objUsage</code></pre>
    </div>
</div>

@code {
    private int objCurrent = 2;

    private const string objUsage = """
        @using TrBlazeUI.Components.Stepper

        <Stepper Current="@current" AriaLabel="Publishing progress">
            <StepperItem Title="Draft" Description="Write the post" />
            <StepperItem Title="Review" Description="Editor sign-off" />
            <StepperItem Title="Publish" />
        </Stepper>

        @code { private int current = 2; }

        @* A step that knows better than its position: *@
        <Stepper Current="3" Orientation="StepperOrientation.Vertical" AriaLabel="Release pipeline">
            <StepperItem Title="Checkout" Status="StepStatus.Done">
                <Trailing><Badge Variant="BadgeVariant.Secondary">4s</Badge></Trailing>
            </StepperItem>
            <StepperItem Title="Restore" Status="StepStatus.Retried" />
            <StepperItem Title="Build" Status="StepStatus.Running" />
            <StepperItem Title="Publish" Status="StepStatus.Failed" />
        </Stepper>
        """;
}
