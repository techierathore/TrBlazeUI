@page "/components/breadcrumb"
@using TrBlazeUI.Components.Breadcrumb
@using TrBlazeUI.Components.Separator

<PageTitle>Breadcrumb Component - TrBlazeUI</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">Breadcrumb Component</h1>
            <p class="text-xl text-muted-foreground">
                Displays the path to the current resource using a hierarchy of links.
            </p>
        </div>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Basic Example</h2>
            <p class="text-sm text-muted-foreground">
                A simple breadcrumb navigation showing the current page path.
            </p>
        </div>
        <Breadcrumb>
            <BreadcrumbItem>
                <BreadcrumbLink Href="/">Home</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
                <BreadcrumbLink Href="/components">Components</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
                <BreadcrumbPage>Breadcrumb</BreadcrumbPage>
            </BreadcrumbItem>
        </Breadcrumb>
    </div>

    <!-- With Ellipsis -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">With Ellipsis</h2>
            <p class="text-sm text-muted-foreground">
                Use ellipsis to indicate collapsed breadcrumb items.
            </p>
        </div>
        <Breadcrumb>
            <BreadcrumbItem>
                <BreadcrumbLink Href="/">Home</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
                <BreadcrumbEllipsis />
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
                <BreadcrumbLink Href="/components">Components</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
                <BreadcrumbPage>Breadcrumb</BreadcrumbPage>
            </BreadcrumbItem>
        </Breadcrumb>
    </div>

    <!-- Custom Separator -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Custom Separator</h2>
            <p class="text-sm text-muted-foreground">
                Customize the separator between breadcrumb items.
            </p>
        </div>
        <Breadcrumb>
            <BreadcrumbItem>
                <BreadcrumbLink Href="/">Home</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator>/</BreadcrumbSeparator>
            <BreadcrumbItem>
                <BreadcrumbLink Href="/components">Components</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator>/</BreadcrumbSeparator>
            <BreadcrumbItem>
                <BreadcrumbPage>Breadcrumb</BreadcrumbPage>
            </BreadcrumbItem>
        </Breadcrumb>
    </div>

    <!-- TR-027: single-line trail in a fixed-height chrome -->
    <div class="space-y-4" data-testid="tr027-breadcrumb-nowrap">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">No wrap (TR-027)</h2>
            <p class="text-sm text-muted-foreground">
                <code>Wrap="false"</code> keeps the trail on one line, so a narrow header bar cannot
                grow a second row when the path runs long. The row gap is also 0 now, so even a
                wrapped trail adds no vertical padding of its own. Drag the browser narrower to
                compare the two rails below.
            </p>
        </div>
        <div class="space-y-6">
            <div class="space-y-2">
                <p class="text-sm font-medium">Wrap="false" — clipped, never taller</p>
                <div class="w-64 overflow-hidden rounded-md border p-2">
                    <Breadcrumb Wrap="false" data-testid="tr027-breadcrumb-nowrap-trail">
                        <BreadcrumbItem>
                            <BreadcrumbLink Href="/">Home</BreadcrumbLink>
                        </BreadcrumbItem>
                        <BreadcrumbSeparator />
                        <BreadcrumbItem>
                            <BreadcrumbLink Href="/components">Components</BreadcrumbLink>
                        </BreadcrumbItem>
                        <BreadcrumbSeparator />
                        <BreadcrumbItem>
                            <BreadcrumbPage>Breadcrumb navigation</BreadcrumbPage>
                        </BreadcrumbItem>
                    </Breadcrumb>
                </div>
            </div>

            <div class="space-y-2">
                <p class="text-sm font-medium">Default (Wrap="true") — wraps, but with no row gap</p>
                <div class="w-64 overflow-hidden rounded-md border p-2">
                    <Breadcrumb data-testid="tr027-breadcrumb-wrap-trail">
                        <BreadcrumbItem>
                            <BreadcrumbLink Href="/">Home</BreadcrumbLink>
                        </BreadcrumbItem>
                        <BreadcrumbSeparator />
                        <BreadcrumbItem>
                            <BreadcrumbLink Href="/components">Components</BreadcrumbLink>
                        </BreadcrumbItem>
                        <BreadcrumbSeparator />
                        <BreadcrumbItem>
                            <BreadcrumbPage>Breadcrumb navigation</BreadcrumbPage>
                        </BreadcrumbItem>
                    </Breadcrumb>
                </div>
            </div>
        </div>
    </div>

    <!-- API Reference -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">API Reference</h2>
        </div>
        <div class="border rounded-lg p-6 space-y-4">
            <div>
                <h3 class="font-semibold mb-2">Components</h3>
                <div class="space-y-2 text-sm">
                    <p><code class="bg-muted px-1 py-0.5 rounded">Breadcrumb</code> - Container with nav element</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">BreadcrumbItem</code> - Individual breadcrumb item</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">BreadcrumbLink</code> - Clickable link</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">BreadcrumbPage</code> - Current page (non-clickable)</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">BreadcrumbSeparator</code> - Separator between items</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">BreadcrumbEllipsis</code> - Collapsed items indicator</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">BreadcrumbList</code> - Optional wrapper; its <code class="bg-muted px-1 py-0.5 rounded">Class</code> and attributes are forwarded onto the list element</p>
                </div>
            </div>
            <div>
                <h3 class="font-semibold mb-2">Breadcrumb parameters</h3>
                <div class="space-y-2 text-sm">
                    <p><code class="bg-muted px-1 py-0.5 rounded">Wrap</code> - bool, default true. Set false for a single-line trail in fixed-height chrome.</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">Class</code> - classes for the <code class="bg-muted px-1 py-0.5 rounded">nav</code> element</p>
                    <p><code class="bg-muted px-1 py-0.5 rounded">ListClass</code> - classes merged over the list element's defaults</p>
                </div>
            </div>
        </div>
    </div>
</div>
