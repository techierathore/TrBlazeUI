@page "/components/timeline"
@using TrBlazeUI.Components.Timeline
@using TrBlazeUI.Components.Badge
@using TrBlazeUI.Icons.Lucide.Components

<PageTitle>Timeline Component - TrBlazeUI</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">Timeline</h1>
        <p class="text-xl text-muted-foreground">
            An ordered list of dated entries — work history, a release log, an audit trail.
        </p>
    </div>

    <div class="rounded-lg border border-alert-info bg-alert-info-bg p-4 text-sm text-alert-info-foreground">
        Semantics come from a real <code>&lt;ol&gt;</code>/<code>&lt;li&gt;</code>, not from an ARIA
        claim — a screen reader announces "list, 3 items" without the component asserting anything.
    </div>

    <!-- Basic -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Basic Example</h2>
            <p class="text-sm text-muted-foreground">
                <code>Meta</code> above, <code>Title</code>, then <code>Subtitle</code>.
                <code>Current</code> fills the marker for the entry in progress.
            </p>
        </div>
        <Timeline>
            <TimelineItem Meta="2022 — present" Title="Senior Engineer" Subtitle="Acme Corp" Current="true" />
            <TimelineItem Meta="2019 — 2022" Title="Engineer" Subtitle="Acme Corp" />
            <TimelineItem Meta="2016 — 2019" Title="Junior Engineer" Subtitle="Initech" />
        </Timeline>
    </div>

    <!-- With body content -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">With body content</h2>
            <p class="text-sm text-muted-foreground">
                Child content renders under the entry — bullet lists, badges, anything.
            </p>
        </div>
        <Timeline>
            <TimelineItem Meta="2.1.0 — 2026-08-11" Title="Consumer feedback release" Current="true">
                <ul class="list-disc space-y-1 pl-5 text-muted-foreground">
                    <li>Catalog-wide attribute splatting</li>
                    <li>Rating, Tabs and NavigationMenu accessibility</li>
                    <li>Full Tailwind utility layer</li>
                </ul>
                <div class="mt-2 flex gap-2">
                    <Badge>accessibility</Badge>
                    <Badge Variant="BadgeVariant.Secondary">css</Badge>
                </div>
            </TimelineItem>
            <TimelineItem Meta="2.0.0 — 2026-07-21" Title="DataTable chrome opt-in">
                <p class="text-muted-foreground">
                    <code>ShowToolbar</code> now defaults to <code>false</code>.
                </p>
            </TimelineItem>
        </Timeline>
    </div>

    <!-- Custom markers -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Custom markers</h2>
            <p class="text-sm text-muted-foreground">
                The <code>Marker</code> fragment replaces the dot — an icon, a number, an initial.
                It is rendered <code>aria-hidden</code>.
            </p>
        </div>
        <Timeline>
            <TimelineItem Meta="Step 1" Title="Order placed" Current="true">
                <Marker><LucideIcon Name="check" Size="12" /></Marker>
            </TimelineItem>
            <TimelineItem Meta="Step 2" Title="Dispatched">
                <Marker><LucideIcon Name="truck" Size="12" /></Marker>
            </TimelineItem>
            <TimelineItem Meta="Step 3" Title="Delivered">
                <Marker><LucideIcon Name="package" Size="12" /></Marker>
            </TimelineItem>
        </Timeline>
    </div>

    <!-- Usage -->
    <div class="space-y-4">
        <h2 class="text-2xl font-semibold">Usage</h2>
        <pre class="overflow-x-auto rounded-lg border bg-muted/30 p-4 text-sm"><code>@objUsage</code></pre>
    </div>
</div>

@code {
    private const string objUsage = """
        @using TrBlazeUI.Components.Timeline

        <Timeline>
            <TimelineItem Meta="2022 — present" Title="Senior Engineer"
                          Subtitle="Acme Corp" Current="true">
                <Marker><LucideIcon Name="check" Size="12" /></Marker>
                <ChildContent>Led the design-system migration.</ChildContent>
            </TimelineItem>
            <TimelineItem Meta="2019 — 2022" Title="Engineer" Subtitle="Acme Corp" />
        </Timeline>
        """;
}
