@namespace TrBlazeUI.Icons.Feather.Components

@if (!string.IsNullOrEmpty(SvgContent))
{
    <svg
        width="@Size"
        height="@Size"
        viewBox="0 0 24 24"
        fill="none"
        stroke="@Color"
        stroke-width="@StrokeWidth"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="@CssClass"
        role="@IconRole"
        aria-label="@AriaLabel"
        aria-hidden="@AriaHiddenValue"
        @attributes="AdditionalAttributes">
        @((MarkupString)SvgContent)
    </svg>
}
else
{
    @* Unknown icon id: render a size-preserving, screen-reader-silent placeholder
       (never a warning glyph that could be mistaken for real content); a one-time
       logger warning identifies the bad Name for the developer. *@
    <span aria-hidden="true"
          data-trblazeui-missing-icon="@Name"
          class="@CssClass"
          style="display:inline-block;width:@(Size)px;height:@(Size)px;vertical-align:middle;"></span>
}
