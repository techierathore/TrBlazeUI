<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NOTE (TR-011): AddRazorSupportForMvc is deliberately NOT set. This is a Blazor
         component library (.razor only, no MVC/.cshtml). Enabling MVC Razor support pulls a
         build-time dependency on the Microsoft.AspNetCore.App shared framework, which is
         unsatisfiable on MAUI Mac Catalyst/iOS/Android (no ASP.NET Core runtime pack ->
         NETSDK1082). Everything the components use lives in the Microsoft.AspNetCore.Components.Web
         PackageReference below. -->

    <!-- NuGet Package Configuration -->
    <PackageId>TrBlazeUI.Components</PackageId>
    <AssemblyName>TrBlazeUI.Components</AssemblyName>
    <RootNamespace>TrBlazeUI.Components</RootNamespace>
    <Description>Pre-styled Blazor components built with shadcn/ui design and Tailwind CSS. Beautiful defaults that you can customize to match your brand.</Description>
    <PackageTags>blazor;ui;components;shadcn;tailwind;styled;design-system</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- <PackageIcon>icon.png</PackageIcon> -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>TrBlazeUI Contributors</Authors>
    <Copyright>Copyright (c) 2025-present TrBlazeUI Contributors</Copyright>

  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazor-ApexCharts" Version="6.1.0" />
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <PackageReference Include="Markdig" Version="0.45.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
  </ItemGroup>

  <!-- Use ProjectReference for local development, PackageReference for packing -->
  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <ProjectReference Include="..\TrBlazeUI.Icons.Lucide\TrBlazeUI.Icons.Lucide.csproj" />
    <ProjectReference Include="..\TrBlazeUI.Primitives\TrBlazeUI.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="TrBlazeUI.Icons.Lucide" Version="2.0.0" />
    <PackageReference Include="TrBlazeUI.Primitives" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Pack AI reference doc for consuming projects -->
    <None Include="..\..\docs\TrBlazeUI-AI-Reference.md" Pack="true" PackagePath="docs\" />
    <!-- Pack AI skill files for consuming projects -->
    <None Include="..\..\docs\skills\claude-code-trblazeui.md" Pack="true" PackagePath="skills\" />
    <None Include="..\..\docs\skills\opencode-trblazeui.md" Pack="true" PackagePath="skills\" />
    <!-- Pack buildTransitive targets to auto-extract docs and deploy skills -->
    <None Include="build\TrBlazeUI.Components.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- Build Tailwind CSS before packing (only on Windows, with local dev check) -->
  <!-- Pre-built CSS is committed to repo, this target only runs during local development on Windows -->
  <Target Name="BuildTrBlazeUICSS" BeforeTargets="BeforeBuild;BeforeRebuild" Condition="'$(OS)' == 'Windows_NT' AND '$(CI)' != 'true'">
    <Message Text="Building TrBlazeUI Tailwind CSS..." Importance="high" />
    <Exec Command="$(MSBuildProjectDirectory)\..\..\tools\tailwindcss.exe -i wwwroot/css/trblazeui-input.css -o wwwroot/trblazeui.css --minify" />
  </Target>

</Project>
