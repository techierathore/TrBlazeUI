@namespace TrBlazeUI.Components.Slider
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="objTrackRef"
     role="slider"
     aria-valuemin="@Min"
     aria-valuemax="@Max"
     aria-valuenow="@CurrentValue"
     aria-disabled="@(Disabled ? "true" : "false")"
     tabindex="@(Disabled ? -1 : 0)"
     class="@CssClass"
     @onkeydown="HandleKeyDown" @attributes="AdditionalAttributes">
    <div class="relative h-2 w-full grow overflow-hidden rounded-full bg-secondary">
        <div class="absolute h-full bg-primary"
             style="width: @(Percentage)%;">
        </div>
    </div>
    <div class="@ThumbClass"
         style="left: @(Percentage)%;">
    </div>
</div>

@code {
    [Parameter]
    public double Value { get; set; }

    [Parameter]
    public EventCallback<double> ValueChanged { get; set; }

    [Parameter]
    public double DefaultValue { get; set; }

    [Parameter]
    public double Min { get; set; } = 0;

    [Parameter]
    public double Max { get; set; } = 100;

    [Parameter]
    public double Step { get; set; } = 1;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public SliderOrientation Orientation { get; set; } = SliderOrientation.Horizontal;

    [Parameter]
    public string? Class { get; set; }

    private ElementReference objTrackRef;
    private double objInternalValue;
    private IJSObjectReference? objJsModule;
    private DotNetObjectReference<Slider>? objDotNetRef;
    private string objSliderId = Guid.NewGuid().ToString("N");
    private bool objJsInitialized;

    private bool IsControlled => ValueChanged.HasDelegate;
    private double CurrentValue => IsControlled ? Value : objInternalValue;
    private double Percentage => ((CurrentValue - Min) / (Max - Min)) * 100;

    protected override void OnInitialized()
    {
        objInternalValue = DefaultValue;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Disabled)
        {
            await InitializeJsAsync();
        }
    }

    private async Task InitializeJsAsync()
    {
        if (objJsInitialized) return;

        try
        {
            objJsModule = await JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/TrBlazeUI.Components/js/slider.js");
            objDotNetRef = DotNetObjectReference.Create(this);
            await objJsModule.InvokeVoidAsync("initializeSlider", objTrackRef, objDotNetRef, objSliderId);
            objJsInitialized = true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to initialize slider JS: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task UpdateValueFromPercentage(double percentage)
    {
        if (Disabled) return;

        // Input validation - reject invalid values
        if (double.IsNaN(percentage) || double.IsInfinity(percentage))
            return;

        // Clamp percentage to valid range
        percentage = Math.Max(0, Math.Min(1, percentage));

        var newValue = Min + (percentage * (Max - Min));
        await SetValueAsync(newValue);
    }

    private async Task SetValueAsync(double value)
    {
        value = Math.Round(value / Step) * Step;
        value = Math.Max(Min, Math.Min(Max, value));

        if (IsControlled)
        {
            await ValueChanged.InvokeAsync(value);
        }
        else
        {
            objInternalValue = value;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Disabled) return;

        var stepSize = Step;
        var largeStep = (Max - Min) / 10;

        switch (e.Key)
        {
            case "ArrowRight":
            case "ArrowUp":
                await SetValueAsync(CurrentValue + stepSize);
                break;
            case "ArrowLeft":
            case "ArrowDown":
                await SetValueAsync(CurrentValue - stepSize);
                break;
            case "PageUp":
                await SetValueAsync(CurrentValue + largeStep);
                break;
            case "PageDown":
                await SetValueAsync(CurrentValue - largeStep);
                break;
            case "Home":
                await SetValueAsync(Min);
                break;
            case "End":
                await SetValueAsync(Max);
                break;
        }
    }

    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "relative flex w-full touch-none select-none items-center",
        Disabled ? "opacity-50 cursor-not-allowed" : "cursor-pointer",
        Class
    );

    private string ThumbClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "absolute block h-5 w-5 rounded-full border-2 border-primary bg-background ring-offset-background transition-colors",
        "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2",
        "disabled:pointer-events-none disabled:opacity-50",
        "-translate-x-1/2 top-1/2 -translate-y-1/2",
        Disabled ? "" : "cursor-grab active:cursor-grabbing"
    );

    public async ValueTask DisposeAsync()
    {
        if (objJsModule != null && objJsInitialized)
        {
            try
            {
                await objJsModule.InvokeVoidAsync("disposeSlider", objSliderId);
                await objJsModule.DisposeAsync();
            }
            catch { }
        }
        objDotNetRef?.Dispose();
    }

    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
