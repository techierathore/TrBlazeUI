@namespace TrBlazeUI.Components.Input

@if (!string.IsNullOrEmpty(Label))
{
    <label for="@EffectiveId" class="mb-2 block text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">@Label</label>
}
<input
    id="@EffectiveId"
    type="@HtmlType"
    class="@CssClass"
    value="@Value"
    placeholder="@Placeholder"
    disabled="@Disabled"
    required="@Required"
    aria-label="@AriaLabel"
    aria-describedby="@AriaDescribedBy"
    aria-invalid="@(AriaInvalid?.ToString().ToLower())"
    @attributes="AdditionalAttributes"
    @oninput="HandleInput"
    @onchange="HandleChange" />
