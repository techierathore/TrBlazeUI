@namespace TrBlazeUI.Components.ScrollArea

<div class="@CssClass" @attributes="AdditionalAttributes">
    <div class="@ThumbClass"></div>
</div>

@code {
    [Parameter]
    public ScrollAreaOrientation Orientation { get; set; } = ScrollAreaOrientation.Vertical;

    [Parameter]
    public string? Class { get; set; }

    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "flex touch-none select-none transition-colors",
        Orientation == ScrollAreaOrientation.Vertical
            ? "h-full w-2.5 border-l border-l-transparent p-[1px]"
            : "h-2.5 flex-col border-t border-t-transparent p-[1px]",
        Class
    );

    private string ThumbClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "relative rounded-full bg-border",
        Orientation == ScrollAreaOrientation.Vertical ? "flex-1" : "flex-1"
    );

    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
