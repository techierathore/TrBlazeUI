@namespace TrBlazeUI.Components.Toggle
@typeparam TValue
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Single choice is a radio group (role="radio" + aria-checked on the items); multiple choice is a
   set of pressed buttons (aria-pressed). One item is the Tab stop and the arrow keys move between
   the rest, so a view switch in a toolbar costs one Tab, not one per option. *@

<div @ref="objRoot"
     role="@(Type == ToggleGroupType.Single ? "radiogroup" : "group")"
     aria-label="@AriaLabel"
     data-slot="toggle-group"
     data-joined="@(Joined ? "true" : null)"
     class="@CssClass"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    private readonly List<ToggleGroupItem<TValue>> objItems = [];
    private ElementReference objRoot;
    private IJSObjectReference? objModule;

    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter]
    public TValue? DefaultValue { get; set; }

    [Parameter]
    public ToggleGroupType Type { get; set; } = ToggleGroupType.Single;

    [Parameter]
    public List<TValue>? Values { get; set; }

    [Parameter]
    public EventCallback<List<TValue>> ValuesChanged { get; set; }

    [Parameter]
    public ToggleVariant Variant { get; set; } = ToggleVariant.Default;

    [Parameter]
    public ToggleSize Size { get; set; } = ToggleSize.Default;

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether the items are drawn as one joined control (shared border, square inner
    /// corners, no gap) - the look of a "Board | Table" view switch. Default is false.
    /// </summary>
    [Parameter]
    public bool Joined { get; set; }

    /// <summary>
    /// Gets or sets whether pressing the chosen item of a single-choice group clears the choice.
    /// Set false for a view switch, where exactly one option must stay chosen. Default is true.
    /// </summary>
    [Parameter]
    public bool AllowDeselect { get; set; } = true;

    /// <summary>
    /// Gets or sets the accessible name of the group, for example <c>"View"</c>.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private TValue? objInternalValue;
    private List<TValue> objInternalValues = new();
    private bool IsControlled => ValueChanged.HasDelegate || ValuesChanged.HasDelegate;

    protected override void OnInitialized()
    {
        objInternalValue = DefaultValue;
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Every item has registered by now; render once more so exactly one of them is the Tab stop.
        StateHasChanged();

        try
        {
            objModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/TrBlazeUI.Components/js/roving-focus.js");
            await objModule.InvokeVoidAsync("attach", objRoot, "[data-slot=toggle-group-item]");
        }
        catch (JSDisconnectedException)
        {
            // Expected during circuit disconnect in Blazor Server.
        }
        catch (InvalidOperationException)
        {
            // JS interop is unavailable during prerendering.
        }
    }

    internal void Register(ToggleGroupItem<TValue> aItem) => objItems.Add(aItem);

    internal void Unregister(ToggleGroupItem<TValue> aItem) => objItems.Remove(aItem);

    internal bool IsTabStop(ToggleGroupItem<TValue> aItem)
    {
        var vEnabled = objItems.Where(i => !i.Disabled).ToList();
        var vPressed = vEnabled.FirstOrDefault(i => IsItemPressed(i.Value));
        return ReferenceEquals(vPressed ?? vEnabled.FirstOrDefault(), aItem);
    }

    internal bool IsItemPressed(TValue? itemValue)
    {
        if (itemValue == null) return false;

        if (Type == ToggleGroupType.Single)
        {
            var currentValue = IsControlled ? Value : objInternalValue;
            return EqualityComparer<TValue>.Default.Equals(currentValue, itemValue);
        }
        else
        {
            var currentValues = IsControlled ? Values : objInternalValues;
            return currentValues?.Contains(itemValue) == true;
        }
    }

    internal async Task ToggleItemAsync(TValue? itemValue)
    {
        if (itemValue == null || Disabled) return;

        if (Type == ToggleGroupType.Single)
        {
            var currentValue = IsControlled ? Value : objInternalValue;
            var isCurrent = EqualityComparer<TValue>.Default.Equals(currentValue, itemValue);
            if (isCurrent && !AllowDeselect)
            {
                return;
            }

            var newValue = isCurrent ? default : itemValue;

            if (IsControlled)
            {
                await ValueChanged.InvokeAsync(newValue);
            }
            else
            {
                objInternalValue = newValue;
                StateHasChanged();
            }
        }
        else
        {
            var currentValues = (IsControlled ? Values : objInternalValues) ?? new List<TValue>();
            var newValues = new List<TValue>(currentValues);

            if (newValues.Contains(itemValue))
            {
                newValues.Remove(itemValue);
            }
            else
            {
                newValues.Add(itemValue);
            }

            if (IsControlled)
            {
                await ValuesChanged.InvokeAsync(newValues);
            }
            else
            {
                objInternalValues = newValues;
                StateHasChanged();
            }
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (objModule != null)
        {
            try
            {
                await objModule.InvokeVoidAsync("detach", objRoot);
                await objModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Expected during circuit disconnect.
            }
        }

        GC.SuppressFinalize(this);
    }

    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        Joined
            ? "inline-flex w-fit items-stretch overflow-hidden rounded-md border border-input"
            : "flex items-center justify-center gap-1",
        Class
    );

    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
