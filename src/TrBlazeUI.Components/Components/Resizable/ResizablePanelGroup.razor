@namespace TrBlazeUI.Components.Resizable
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="objGroupRef" class="@CssClass" @attributes="AdditionalAttributes" style="@Style">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    /// <summary>
    /// The panels to display.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The direction of the panels.
    /// </summary>
    [Parameter]
    public ResizableDirection Direction { get; set; } = ResizableDirection.Horizontal;

    /// <summary>
    /// Additional CSS classes to apply.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference objGroupRef;
    private IJSObjectReference? objJsModule;
    private DotNetObjectReference<ResizablePanelGroup>? objDotNetRef;
    private string objGroupId = Guid.NewGuid().ToString("N");
    private bool objJsInitialized;

    private List<double> objPanelSizes = new();
    private List<double> objPanelDefaultSizes = new();
    private List<double> objPanelMinSizes = new();
    private List<double> objPanelMaxSizes = new();
    private int objPanelCount = 0;
    private int objHandleCount = 0;

    internal ResizableDirection GetDirection() => Direction;

    internal int RegisterPanel(double defaultSize, double minSize, double maxSize)
    {
        var index = objPanelCount++;
        objPanelDefaultSizes.Add(defaultSize);
        objPanelMinSizes.Add(minSize);
        objPanelMaxSizes.Add(maxSize);

        if (objPanelSizes.Count <= index)
        {
            objPanelSizes.Add(defaultSize);
        }

        return index;
    }

    internal double GetPanelSize(int index)
    {
        if (index >= 0 && index < objPanelSizes.Count)
        {
            return objPanelSizes[index];
        }
        return index < objPanelDefaultSizes.Count ? objPanelDefaultSizes[index] : 50;
    }

    internal int RegisterHandle()
    {
        return objHandleCount++;
    }

    internal async Task StartResizeAsync(int handleIndex, double clientX, double clientY, long pointerId)
    {
        if (objJsModule != null && objJsInitialized)
        {
            await objJsModule.InvokeVoidAsync("startResize", objGroupId, handleIndex, clientX, clientY, objPanelSizes.ToArray(), pointerId);
        }
    }

    [JSInvokable]
    public void UpdatePanelSizes(double[] newSizes)
    {
        // Input validation
        if (newSizes == null || newSizes.Length == 0)
            return;

        // Reject excessively large arrays (potential DoS)
        if (newSizes.Length > 100)
            return;

        for (int i = 0; i < newSizes.Length && i < objPanelSizes.Count; i++)
        {
            // Skip invalid values
            if (double.IsNaN(newSizes[i]) || double.IsInfinity(newSizes[i]))
                continue;

            // Apply min/max constraints
            var size = Math.Max(objPanelMinSizes[i], Math.Min(objPanelMaxSizes[i], newSizes[i]));
            objPanelSizes[i] = size;
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJsAsync();
        }
    }

    private async Task InitializeJsAsync()
    {
        if (objJsInitialized) return;

        try
        {
            objJsModule = await JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/TrBlazeUI.Components/js/resizable.js");
            objDotNetRef = DotNetObjectReference.Create(this);

            var isHorizontal = Direction == ResizableDirection.Horizontal;
            await objJsModule.InvokeVoidAsync("initializeResizable", objGroupRef, objDotNetRef, objGroupId, isHorizontal);
            objJsInitialized = true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to initialize resizable JS: {ex.Message}");
        }
    }

    private string Style => Direction == ResizableDirection.Horizontal
        ? "display: flex; flex-direction: row; height: 100%; width: 100%;"
        : "display: flex; flex-direction: column; height: 100%; width: 100%;";

    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "overflow-hidden",
        Class
    );

    public async ValueTask DisposeAsync()
    {
        if (objJsModule != null && objJsInitialized)
        {
            try
            {
                await objJsModule.InvokeVoidAsync("disposeResizable", objGroupId);
                await objJsModule.DisposeAsync();
            }
            catch { }
        }
        objDotNetRef?.Dispose();
    }
}
