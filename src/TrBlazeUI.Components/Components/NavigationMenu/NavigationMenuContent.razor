@namespace TrBlazeUI.Components.NavigationMenu
@using TrBlazeUI.Components.Utilities
@using TrBlazeUI.Primitives.Floating
@using TrBlazeUI.Primitives.Services
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@*
    Navigation Menu Content - the dropdown content panel.
    Uses FloatingPortal for proper positioning that escapes overflow containers.
*@

@if (MenuItem?.IsOpen == true && MenuItem.TriggerElementRef.HasValue)
{
    <FloatingPortal IsOpen="true"
                    AnchorElement="@MenuItem.TriggerElementRef"
                    PortalId="@objPortalId"
                    Side="@Side"
                    Align="@Align"
                    Offset="@Offset"
                    Strategy="@Strategy"
                    ZIndex="@ZIndex"
                    OnReady="@HandlePortalReady">
        <div @ref="objContentRef"
             class="@CssClass"
             role="menu"
             tabindex="@(IsKeyboardNavigationEnabled ? -1 : null)"
             data-state="open"
             @onmouseenter="HandleMouseEnter"
             @onmouseleave="HandleMouseLeave"
             @onclick="HandleClick"
             @attributes="AdditionalAttributes">
            @* Tells NavigationMenuLink it is inside a real role="menu" popup. *@
            <CascadingValue Name="NavigationMenuInMenu" Value="true" IsFixed="true">
                @ChildContent
            </CascadingValue>
        </div>
    </FloatingPortal>
}

@code {
    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference objContentRef;
    private IJSObjectReference? objNavModule;
    private IJSObjectReference? objKeyboardCleanup;
    private DotNetObjectReference<NavigationMenuContent>? objDotNetRef;
    private bool objModuleLoaded = false;
    private bool objWasOpen = false;
    private readonly string objPortalId = $"nav-menu-portal-{Guid.NewGuid():N}";

    /// <summary>
    /// Reference to the parent menu item.
    /// </summary>
    [CascadingParameter]
    public NavigationMenuItem? MenuItem { get; set; }

    /// <summary>
    /// The content to render in the dropdown.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the content.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Preferred side for positioning the content relative to the trigger.
    /// Default is Bottom.
    /// </summary>
    [Parameter]
    public PopoverSide Side { get; set; } = PopoverSide.Bottom;

    /// <summary>
    /// Alignment relative to the trigger element.
    /// Default is Start (left-aligned).
    /// </summary>
    [Parameter]
    public PopoverAlign Align { get; set; } = PopoverAlign.Start;

    /// <summary>
    /// Offset distance from the trigger element in pixels.
    /// Default is 6 (equivalent to mt-1.5).
    /// </summary>
    [Parameter]
    public int Offset { get; set; } = 6;

    /// <summary>
    /// CSS positioning strategy: "absolute" or "fixed".
    /// Use "fixed" for content that needs to escape stacking contexts or overflow containers.
    /// Default is "fixed".
    /// </summary>
    [Parameter]
    public string Strategy { get; set; } = "fixed";

    /// <summary>
    /// CSS z-index value for the floating content.
    /// Default is 50.
    /// </summary>
    [Parameter]
    public int ZIndex { get; set; } = 50;

    protected override void OnInitialized()
    {
        MenuItem?.RegisterContent(this);
    }

    /// <summary>
    /// Gets whether keyboard navigation is enabled on the parent menu.
    /// </summary>
    private bool IsKeyboardNavigationEnabled => MenuItem?.Menu?.EnableKeyboardNavigation == true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var isOpen = MenuItem?.IsOpen == true;

        // Clean up keyboard navigation when menu closes
        if (!isOpen && objWasOpen)
        {
            await CleanupKeyboardAsync();
        }

        objWasOpen = isOpen;
    }

    /// <summary>
    /// Called when FloatingPortal has positioned content and it is visible.
    /// </summary>
    private async Task HandlePortalReady()
    {
        if (!IsKeyboardNavigationEnabled) return;

        try
        {
            await EnsureModuleLoadedAsync();
            if (objNavModule != null)
            {
                objDotNetRef = DotNetObjectReference.Create(this);
                objKeyboardCleanup = await objNavModule.InvokeAsync<IJSObjectReference>(
                    "setupKeyboardNavigation", objContentRef, objDotNetRef);
                await objNavModule.InvokeVoidAsync("navigateFirst", objContentRef);
            }
        }
        catch
        {
            // Keyboard navigation setup failed
        }
    }

    private async Task EnsureModuleLoadedAsync()
    {
        if (!objModuleLoaded)
        {
            try
            {
                objNavModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/TrBlazeUI.Components/js/navigation-menu.js");
                objModuleLoaded = true;
            }
            catch { }
        }
    }

    /// <summary>
    /// Focuses the first focusable item in the content.
    /// </summary>
    internal async Task FocusFirstItemAsync()
    {
        await EnsureModuleLoadedAsync();
        if (objNavModule != null)
        {
            await objNavModule.InvokeVoidAsync("navigateFirst", objContentRef);
        }
    }

    /// <summary>
    /// Called from JavaScript when Escape key is pressed.
    /// </summary>
    [JSInvokable]
    public async Task HandleEscapeKey()
    {
        if (MenuItem != null)
        {
            MenuItem.IsOpen = false;
            await MenuItem.FocusTriggerAsync();
        }
    }

    private void HandleMouseEnter()
    {
        if (MenuItem != null)
        {
            MenuItem.CancelCloseTimer();
            MenuItem.IsOpen = true;
        }
    }

    private void HandleMouseLeave()
    {
        MenuItem?.StartCloseTimer();
    }

    private void HandleClick()
    {
        // Close the menu immediately when any content is clicked
        // This provides faster feedback than waiting for LocationChanged
        if (MenuItem != null)
        {
            MenuItem.IsOpen = false;
        }
    }

    private async Task CleanupKeyboardAsync()
    {
        if (objKeyboardCleanup != null)
        {
            try
            {
                await objKeyboardCleanup.InvokeVoidAsync("dispose");
                await objKeyboardCleanup.DisposeAsync();
                objKeyboardCleanup = null;
                objDotNetRef?.Dispose();
                objDotNetRef = null;
            }
            catch { }
        }
    }

    /// <summary>
    /// Gets the computed CSS classes for the content panel.
    /// </summary>
    private string CssClass => ClassNames.cn(
        "w-max",
        "rounded-md border bg-popover text-popover-foreground shadow-lg",
        "outline-none ring-0 focus:outline-none focus:ring-0 focus-visible:outline-none focus-visible:ring-0 focus-within:bg-popover",
        "data-[state=open]:animate-in data-[state=closed]:animate-out",
        "data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0",
        "data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95",
        Class
    );

    public async ValueTask DisposeAsync()
    {
        await CleanupKeyboardAsync();

        if (objNavModule != null)
        {
            await objNavModule.DisposeAsync();
        }
    }
}
