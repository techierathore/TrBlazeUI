@namespace TrBlazeUI.Components.PasswordStrength

@* A live strength meter for a password field. The score is exposed as text as well as colour,
   and announced politely, so it is not conveyed by colour alone (WCAG 1.4.1). *@

<div class="@CssClass" @attributes="AdditionalAttributes">
    <div class="flex gap-1" aria-hidden="true">
        @for (var i = 1; i <= 4; i++)
        {
            <span class="@SegmentCssClass(i)"></span>
        }
    </div>
    <p class="mt-1 text-xs @LabelCssClass" aria-live="polite">@objDescription</p>
</div>

@code {
    /// <summary>
    /// Gets or sets the password to evaluate.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets the minimum acceptable length. Shorter passwords never score above Weak.
    /// </summary>
    [Parameter]
    public int MinimumLength { get; set; } = 8;

    /// <summary>
    /// Gets or sets the callback raised when the computed score changes.
    /// </summary>
    [Parameter]
    public EventCallback<PasswordStrengthLevel> LevelChanged { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the strength level of the current value.
    /// </summary>
    public PasswordStrengthLevel Level => objLevel;

    private PasswordStrengthLevel objLevel = PasswordStrengthLevel.Empty;

    private string objDescription = "Enter a password";

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        var vLevel = Evaluate(Value, MinimumLength);

        if (vLevel != objLevel)
        {
            objLevel = vLevel;

            if (LevelChanged.HasDelegate)
            {
                await LevelChanged.InvokeAsync(vLevel);
            }
        }

        objDescription = objLevel switch
        {
            PasswordStrengthLevel.Weak => "Weak password",
            PasswordStrengthLevel.Fair => "Fair password",
            PasswordStrengthLevel.Good => "Good password",
            PasswordStrengthLevel.Strong => "Strong password",
            _ => "Enter a password"
        };
    }

    /// <summary>
    /// Scores a password on length and character variety.
    /// </summary>
    /// <param name="aValue">The password to score.</param>
    /// <param name="aMinimumLength">The minimum acceptable length.</param>
    /// <returns>The strength level.</returns>
    public static PasswordStrengthLevel Evaluate(string? aValue, int aMinimumLength = 8)
    {
        if (string.IsNullOrEmpty(aValue))
        {
            return PasswordStrengthLevel.Empty;
        }

        var vScore = 0;

        if (aValue.Length >= aMinimumLength) { vScore++; }
        if (aValue.Length >= aMinimumLength + 4) { vScore++; }
        if (aValue.Any(char.IsLower) && aValue.Any(char.IsUpper)) { vScore++; }
        if (aValue.Any(char.IsDigit)) { vScore++; }
        if (aValue.Any(c => !char.IsLetterOrDigit(c))) { vScore++; }

        if (aValue.Length < aMinimumLength)
        {
            return PasswordStrengthLevel.Weak;
        }

        return vScore switch
        {
            <= 2 => PasswordStrengthLevel.Weak,
            3 => PasswordStrengthLevel.Fair,
            4 => PasswordStrengthLevel.Good,
            _ => PasswordStrengthLevel.Strong
        };
    }

    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn("w-full", Class);

    private string SegmentCssClass(int aSegment) => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "h-1 flex-1 rounded-full",
        aSegment <= (int)objLevel
            ? objLevel switch
            {
                PasswordStrengthLevel.Weak => "bg-destructive",
                PasswordStrengthLevel.Fair => "bg-alert-warning",
                PasswordStrengthLevel.Good => "bg-alert-info",
                _ => "bg-success"
            }
            : "bg-muted"
    );

    private string LabelCssClass => objLevel switch
    {
        PasswordStrengthLevel.Weak => "text-destructive",
        PasswordStrengthLevel.Fair => "text-alert-warning-foreground",
        PasswordStrengthLevel.Good => "text-alert-info-foreground",
        PasswordStrengthLevel.Strong => "text-success",
        _ => "text-muted-foreground"
    };
}
