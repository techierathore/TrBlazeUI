@namespace TrBlazeUI.Components.ContextMenu
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<CascadingValue Value="this" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool? Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    internal bool IsOpen { get; private set; }
    internal double X { get; private set; }
    internal double Y { get; private set; }
    internal int FocusedIndex => Level.FocusedIndex;

    /// <summary>The menu's top list: its items for the arrow keys and its open submenu (Chatur TR-020).</summary>
    internal MenuLevel<IContextMenuItem> Level { get; } = new();

    private DotNetObjectReference<ContextMenu>? objDotNetRef;

    protected override void OnInitialized()
    {
        objDotNetRef = DotNetObjectReference.Create(this);
    }

    internal void RegisterMenuItem(IContextMenuItem item) => Level.Register(item);

    internal void UnregisterMenuItem(IContextMenuItem item) => Level.Unregister(item);

    internal List<IContextMenuItem> GetMenuItems() => Level.Items;

    internal void SetFocusedIndex(int index)
    {
        Level.FocusedIndex = index;
        StateHasChanged();
    }

    internal async Task OpenAtAsync(double x, double y)
    {
        X = x;
        Y = y;
        IsOpen = true;
        Level.Reset();

        if (Open.HasValue)
        {
            await OpenChanged.InvokeAsync(true);
        }

        StateHasChanged();
    }

    internal async Task CloseAsync()
    {
        IsOpen = false;
        Level.Reset();

        if (Open.HasValue)
        {
            await OpenChanged.InvokeAsync(false);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task HandleClickOutside()
    {
        await CloseAsync();
    }

    public ValueTask DisposeAsync()
    {
        objDotNetRef?.Dispose();
        return ValueTask.CompletedTask;
    }

    /// <summary>
    /// Gets or sets additional HTML attributes.
    /// </summary>
    /// <remarks>
    /// This component renders no element of its own - it only supplies a cascading context - so
    /// the attributes are accepted (never throwing) but are not emitted. Put the attribute on the
    /// component that renders the visible element instead.
    /// </remarks>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
