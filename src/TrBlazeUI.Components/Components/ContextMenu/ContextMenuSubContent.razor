@namespace TrBlazeUI.Components.ContextMenu
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@* The list a submenu opens beside its trigger row (Chatur TR-020). ArrowLeft or Escape closes it
   and puts the focus back on the row; it opens on the left when the right has no room, and when
   neither side has room it is pulled back inside the window (Chatur TR-024). *@
@if (Sub?.IsOpen == true)
{
    <div @ref="objListRef"
         id="@Sub.ContentId"
         role="menu"
         aria-labelledby="@Sub.TriggerId"
         tabindex="-1"
         class="@CssClass"
         data-state="open"
         data-side="@objPlacement.Side"
         data-slot="context-menu-sub-content"
         @onclick:stopPropagation="true"
         @onkeydown="HandleKeyDown"
         @onkeydown:stopPropagation="true"
         @onkeydown:preventDefault="true"
         @attributes="AdditionalAttributes"
         style="@StyleAttribute">
        <CascadingValue Name="ContextMenuLevel" Value="Sub.ChildLevel" IsFixed="false">
            @ChildContent
        </CascadingValue>
    </div>
}

@code {
    [CascadingParameter]
    private ContextMenuSub? Sub { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes for the list.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets the list's items: ContextMenuItem, ContextMenuLabel, ContextMenuSeparator,
    /// or another ContextMenuSub.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets whether ArrowDown on the last item wraps to the first. Default is true.
    /// </summary>
    [Parameter]
    public bool Loop { get; set; } = true;

    /// <summary>
    /// Gets or sets additional HTML attributes forwarded to the list element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly SubmenuPlacer objPlacer = new();
    private ElementReference objListRef;
    private SubmenuPlacement objPlacement = SubmenuPlacement.Default;

    private string? StyleAttribute => SubmenuPlacer.Style(objPlacement, AdditionalAttributes?.GetValueOrDefault("style")?.ToString());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Sub?.IsOpen != true)
        {
            objPlacement = SubmenuPlacement.Default;
            return;
        }

        // Placed again on every render while open, not only when it opens: its rows can change
        // while it is open, and a list placed for its old rows ran past the window (Chatur TR-025).
        // fit() measures without our last placement, so a second pass gives the same answer and
        // the re-render below happens only when the place really changed.
        var vPlacement = await objPlacer.FitAsync(JSRuntime, objListRef);
        if (!SubmenuPlacer.IsSame(vPlacement, objPlacement))
        {
            objPlacement = vPlacement;
            StateHasChanged();
        }

        if (Sub.TakeFocusFirst())
        {
            var vItem = Sub.ChildLevel.Move("Home", Loop, aItem => aItem.IsDisabled);
            if (vItem != null)
            {
                await vItem.FocusAsync();
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Sub == null)
        {
            return;
        }

        switch (e.Key)
        {
            case "ArrowLeft":
            case "Escape":
                await Sub.CloseAndFocusTriggerAsync();
                break;

            case "ArrowRight":
                if (Sub.ChildLevel.Focused is ContextMenuSubTrigger vTrigger)
                {
                    vTrigger.OpenFromKeyboard();
                }
                break;

            default:
                var vItem = Sub.ChildLevel.Move(e.Key, Loop, aItem => aItem.IsDisabled);
                if (vItem != null)
                {
                    await vItem.FocusAsync();
                }
                break;
        }
    }

    public ValueTask DisposeAsync() => objPlacer.DisposeAsync();

    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        SubmenuPlacer.ListClasses,
        Class
    );
}
