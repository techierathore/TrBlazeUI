@namespace TrBlazeUI.Components.ContextMenu
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (Context?.IsOpen == true)
{
    <div class="fixed inset-0 z-40"
         @onclick="HandleOverlayClick"
         @onclick:stopPropagation="true"
         @oncontextmenu="HandleOverlayClose"
         @oncontextmenu:preventDefault="true"></div>
    <div @ref="objContentRef"
         class="@CssClass"
         style="position: fixed; left: @(Context.X)px; top: @(Context.Y)px; z-index: 50;"
         @onclick:stopPropagation="true"
         @onkeydown="HandleKeyDown"
         @onkeydown:preventDefault="true"
         @oncontextmenu:preventDefault="true"
         tabindex="-1"
         data-autofocus
         role="menu"
         @attributes="AdditionalAttributes">
        <div class="p-1">
            @ChildContent
        </div>
    </div>
}

@code {
    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [CascadingParameter]
    public ContextMenu? Context { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Loop { get; set; } = true;

    private ElementReference objContentRef;
    private bool objWasClosed = true;
    private IJSObjectReference? objPortalModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Context?.IsOpen == true && objWasClosed)
        {
            objWasClosed = false;
            try
            {
                // Load portal module and trigger autofocus
                objPortalModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/TrBlazeUI.Primitives/js/primitives/portal.js");
                await objPortalModule.InvokeVoidAsync("triggerAutofocus", objContentRef);
            }
            catch
            {
                // Ignore errors during prerendering
            }
        }
        else if (Context?.IsOpen != true)
        {
            objWasClosed = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (objPortalModule != null)
        {
            try
            {
                await objPortalModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Expected during circuit disconnect.
            }
            catch (TaskCanceledException)
            {
                // The page went away before it answered; the module died with it (REQ-UI-028).
            }
        }
    }

    private async Task HandleOverlayClick()
    {
        if (Context != null)
        {
            await Context.CloseAsync();
        }
    }

    private async Task HandleOverlayClose(MouseEventArgs e)
    {
        if (Context != null)
        {
            await Context.CloseAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Context == null) return;

        switch (e.Key)
        {
            case "Escape":
                await Context.CloseAsync();
                break;

            case "ArrowRight":
                // On a submenu row ArrowRight opens the submenu (Chatur TR-020).
                if (Context.Level.Focused is ContextMenuSubTrigger vTrigger)
                {
                    vTrigger.OpenFromKeyboard();
                }
                break;

            default:
                var vItem = Context.Level.Move(e.Key, Loop, aItem => aItem.IsDisabled);
                if (vItem != null)
                {
                    Context.SetFocusedIndex(Context.Level.FocusedIndex);
                    await vItem.FocusAsync();
                }
                break;
        }
    }

    // No overflow-hidden: a submenu list is drawn outside this box, beside its trigger row (Chatur TR-020).
    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "min-w-[8rem] rounded-md border bg-popover text-popover-foreground shadow-md outline-none",
        "animate-in fade-in-0 zoom-in-95",
        Class
    );
}
