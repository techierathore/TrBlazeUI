@namespace TrBlazeUI.Components.Menubar
@implements IMenubarItem
@implements IDisposable

<div @ref="objItemRef"
     role="menuitem"
     class="@CssClass"
     tabindex="-1"
     aria-disabled="@(Disabled ? "true" : null)"
     data-disabled="@(Disabled ? "" : null)"
     @onclick="HandleClick"
     @onmouseenter="HandleMouseEnter"
     @onkeydown="HandleKeyDown"
     @onkeydown:preventDefault="true"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter]
    public MenubarMenu? Menu { get; set; }

    [CascadingParameter(Name = "MenubarLevel")]
    private MenuLevel<IMenubarItem>? ParentLevel { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Inset { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference objItemRef;
    private MenuLevel<IMenubarItem>? objLevel;

    public bool IsDisabled => Disabled;

    protected override void OnInitialized()
    {
        // Inside a MenubarSubContent the item belongs to that submenu's list (Chatur TR-020).
        objLevel = ParentLevel ?? Menu?.Level;
        objLevel?.Register(this);
    }

    public async Task FocusAsync()
    {
        try
        {
            await objItemRef.FocusAsync();
        }
        catch
        {
            // Ignore focus errors
        }
    }

    private async Task HandleClick()
    {
        if (!Disabled)
        {
            await OnClick.InvokeAsync();
            Menu?.Close();
        }
    }

    // Pointing at an ordinary row closes a submenu open beside a sibling row.
    private void HandleMouseEnter()
    {
        objLevel?.SetOpenSub(null);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Disabled) return;

        if (e.Key == "Enter" || e.Key == " ")
        {
            await HandleClick();
        }
    }

    public void Dispose()
    {
        objLevel?.Unregister(this);
    }

    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "relative flex cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none",
        "focus:bg-accent focus:text-accent-foreground",
        "hover:bg-accent hover:text-accent-foreground",
        Disabled ? "pointer-events-none opacity-50" : null,
        Inset ? "pl-8" : null,
        Class
    );
}
