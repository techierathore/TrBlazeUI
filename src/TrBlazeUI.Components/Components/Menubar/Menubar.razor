@namespace TrBlazeUI.Components.Menubar

<div role="menubar" class="@CssClass" @onkeydown="HandleKeyDown" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    internal string? ActiveMenu { get; private set; }

    private List<MenubarMenu> objMenus = new();

    internal void RegisterMenu(MenubarMenu menu)
    {
        if (!objMenus.Contains(menu))
        {
            objMenus.Add(menu);
        }
    }

    internal void UnregisterMenu(MenubarMenu menu)
    {
        objMenus.Remove(menu);
    }

    internal List<MenubarMenu> GetMenus() => objMenus;

    internal void SetActiveMenu(string? menuId)
    {
        ActiveMenu = menuId;
        StateHasChanged();
    }

    internal void NavigateToNextMenu()
    {
        if (objMenus.Count == 0 || ActiveMenu == null) return;

        var currentIndex = objMenus.FindIndex(m => m.MenuId == ActiveMenu);
        if (currentIndex == -1) return;

        var nextIndex = (currentIndex + 1) % objMenus.Count;
        objMenus[nextIndex].Open();
    }

    internal void NavigateToPreviousMenu()
    {
        if (objMenus.Count == 0 || ActiveMenu == null) return;

        var currentIndex = objMenus.FindIndex(m => m.MenuId == ActiveMenu);
        if (currentIndex == -1) return;

        var prevIndex = currentIndex == 0 ? objMenus.Count - 1 : currentIndex - 1;
        objMenus[prevIndex].Open();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (ActiveMenu == null) return;

        switch (e.Key)
        {
            case "ArrowRight":
                NavigateToNextMenu();
                break;
            case "ArrowLeft":
                NavigateToPreviousMenu();
                break;
        }
    }

    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "relative z-50 flex h-10 items-center space-x-1 rounded-md border bg-background p-1",
        Class
    );
}
