@namespace TrBlazeUI.Components.Menubar
@implements IDisposable

@* A submenu inside a Menubar menu (Chatur TR-020): holds a MenubarSubTrigger and a
   MenubarSubContent, and may sit inside another MenubarSubContent to any depth. *@
<div class="relative" data-slot="menubar-sub" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    /// <summary>
    /// Gets or sets the menu this submenu belongs to.
    /// </summary>
    [CascadingParameter]
    public MenubarMenu? Menu { get; set; }

    [CascadingParameter(Name = "MenubarLevel")]
    private MenuLevel<IMenubarItem>? ParentLevel { get; set; }

    /// <summary>
    /// Gets or sets the trigger row and the list that opens beside it.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes forwarded to the wrapper element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private MenuLevel<IMenubarItem>? objHostLevel;
    private bool objFocusFirstPending;
    private readonly string objId = Guid.NewGuid().ToString("N");

    /// <summary>Gets the submenu's own list: its items for the arrow keys and its open submenu.</summary>
    internal MenuLevel<IMenubarItem> ChildLevel { get; } = new();

    /// <summary>Gets or sets the trigger row, set by MenubarSubTrigger.</summary>
    internal MenubarSubTrigger? Trigger { get; set; }

    internal string TriggerId => $"menubar-sub-trigger-{objId}";

    internal string ContentId => $"menubar-sub-content-{objId}";

    internal bool IsOpen => objHostLevel != null && ReferenceEquals(objHostLevel.OpenSub, this);

    protected override void OnInitialized()
    {
        objHostLevel = ParentLevel ?? Menu?.Level;
        if (objHostLevel != null)
        {
            objHostLevel.OpenSubChanged += HandleOpenSubChanged;
        }
    }

    /// <summary>Opens this submenu and closes any sibling.</summary>
    internal void Open() => objHostLevel?.SetOpenSub(this);

    /// <summary>Opens this submenu and moves the focus to its first enabled item once it is drawn.</summary>
    internal void OpenAndFocusFirst()
    {
        objFocusFirstPending = true;
        if (IsOpen)
        {
            StateHasChanged();
            return;
        }

        Open();
    }

    /// <summary>Tells MenubarSubContent, once, that it should focus its first item.</summary>
    /// <returns>Whether the focus should move.</returns>
    internal bool TakeFocusFirst()
    {
        var vPending = objFocusFirstPending;
        objFocusFirstPending = false;
        return vPending;
    }

    /// <summary>Closes this submenu and puts the focus back on its trigger row.</summary>
    /// <returns>A task that completes when the trigger has the focus.</returns>
    internal async Task CloseAndFocusTriggerAsync()
    {
        if (objHostLevel == null)
        {
            return;
        }

        if (IsOpen)
        {
            objHostLevel.SetOpenSub(null);
        }

        if (Trigger != null)
        {
            objHostLevel.MarkFocused(Trigger);
            await Trigger.FocusAsync();
        }
    }

    private void HandleOpenSubChanged()
    {
        if (!IsOpen)
        {
            ChildLevel.Reset();
            objFocusFirstPending = false;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (objHostLevel != null)
        {
            objHostLevel.OpenSubChanged -= HandleOpenSubChanged;
            objHostLevel.Forget(this);
        }
    }
}
