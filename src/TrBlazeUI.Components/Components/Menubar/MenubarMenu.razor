@namespace TrBlazeUI.Components.Menubar
@implements IDisposable

<div class="relative" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [CascadingParameter]
    public Menubar? Context { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    internal string MenuId { get; } = Guid.NewGuid().ToString();
    internal bool IsOpen => Context?.ActiveMenu == MenuId;
    internal int FocusedIndex => Level.FocusedIndex;

    /// <summary>The menu's top list: its items for the arrow keys and its open submenu.</summary>
    internal MenuLevel<IMenubarItem> Level { get; } = new();

    protected override void OnInitialized()
    {
        Context?.RegisterMenu(this);
    }

    internal void RegisterMenuItem(IMenubarItem item) => Level.Register(item);

    internal void UnregisterMenuItem(IMenubarItem item) => Level.Unregister(item);

    internal List<IMenubarItem> GetMenuItems() => Level.Items;

    internal void SetFocusedIndex(int index)
    {
        Level.FocusedIndex = index;
    }

    internal void Open()
    {
        Level.Reset();
        Context?.SetActiveMenu(MenuId);
    }

    internal void Close()
    {
        if (IsOpen)
        {
            Level.Reset();
            Context?.SetActiveMenu(null);
        }
    }

    internal void Toggle()
    {
        if (IsOpen)
        {
            Close();
        }
        else
        {
            Open();
        }
    }

    public void Dispose()
    {
        Context?.UnregisterMenu(this);
    }
}
