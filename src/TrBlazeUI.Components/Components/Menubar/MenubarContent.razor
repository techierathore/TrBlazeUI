@namespace TrBlazeUI.Components.Menubar
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (Menu?.IsOpen == true)
{
    <div class="fixed inset-0 z-40" @onclick="HandleOverlayClick" @onclick:stopPropagation="true"></div>
    <div @ref="objContentRef"
         class="@CssClass"
         data-state="open"
         role="menu"
         tabindex="-1"
         data-autofocus
         @onclick:stopPropagation="true"
         @onkeydown="HandleKeyDown"
         @onkeydown:stopPropagation="true"
         @onkeydown:preventDefault="@objShouldPreventDefault"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter]
    public MenubarMenu? Menu { get; set; }

    [CascadingParameter]
    public Menubar? Context { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public MenubarContentAlign Align { get; set; } = MenubarContentAlign.Start;

    [Parameter]
    public bool Loop { get; set; } = true;

    private ElementReference objContentRef;
    private bool objWasClosed = true;
    private bool objShouldPreventDefault = true;
    private IJSObjectReference? objPortalModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Menu?.IsOpen == true && objWasClosed)
        {
            objWasClosed = false;
            try
            {
                // Load portal module and trigger autofocus
                objPortalModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/TrBlazeUI.Primitives/js/primitives/portal.js");
                await objPortalModule.InvokeVoidAsync("triggerAutofocus", objContentRef);
            }
            catch
            {
                // Ignore errors during prerendering
            }
        }
        else if (Menu?.IsOpen != true)
        {
            objWasClosed = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (objPortalModule != null)
        {
            try
            {
                await objPortalModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Expected during circuit disconnect.
            }
            catch (TaskCanceledException)
            {
                // The page went away before it answered; the module died with it (REQ-UI-028).
            }
        }
    }

    private void HandleOverlayClick()
    {
        Menu?.Close();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Menu == null) return;

        switch (e.Key)
        {
            case "Escape":
                Menu.Close();
                break;

            case "ArrowRight":
                // On a submenu row ArrowRight opens the submenu (Chatur TR-020); elsewhere it moves to the next menu.
                if (Menu.Level.Focused is MenubarSubTrigger vTrigger && !vTrigger.IsDisabled)
                {
                    vTrigger.OpenFromKeyboard();
                }
                else
                {
                    Context?.NavigateToNextMenu();
                }
                break;

            case "ArrowLeft":
                Context?.NavigateToPreviousMenu();
                break;

            default:
                var vItem = Menu.Level.Move(e.Key, Loop, aItem => aItem.IsDisabled);
                if (vItem != null)
                {
                    await vItem.FocusAsync();
                }
                break;
        }
    }

    private string AlignClass => Align switch
    {
        MenubarContentAlign.Start => "left-0",
        MenubarContentAlign.Center => "left-1/2 -translate-x-1/2",
        MenubarContentAlign.End => "right-0",
        _ => "left-0"
    };

    // No overflow-hidden: a submenu list is drawn outside this box, beside its trigger row (Chatur TR-020).
    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "absolute top-full mt-1 z-50 min-w-[12rem] rounded-md border bg-popover p-1 text-popover-foreground shadow-md",
        "data-[state=open]:animate-in data-[state=closed]:animate-out",
        "data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0",
        "data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95",
        AlignClass,
        Class
    );
}
