@namespace TrBlazeUI.Components.Chart
@typeparam TItem where TItem : class
@inherits ChartBase<TItem>

<div class="@ContainerCssClass" data-slot="radial-chart" @attributes="AdditionalAttributes">
    @if (ChildContent is null && !CanRenderDefaultSeries)
    {
        @* No child series and no Items/XValue/YValue triplet: show why instead of an
           indistinguishable empty box (TR-011a). *@
        <div class="@EmptyStateCssClass" style="@EmptyStateStyle" data-slot="chart-empty" role="status">
            @EmptyStateText
        </div>
    }
    else
    {
        <DisconnectSafeApexChart TItem="TItem"
                                 Title="@Title"
                                 Options="@objOptions"
                                 Height="@Height"
                                 Width="@Width">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                <ApexPointSeries TItem="TItem"
                                 Items="@DefaultItems"
                                 Name="@DefaultSeriesName"
                                 SeriesType="SeriesType.RadialBar"
                                 ShowDataLabels="@DefaultShowDataLabels"
                                 XValue="@DefaultXValue"
                                 YValue="@DefaultYValue" />
            }
        </DisconnectSafeApexChart>
    }
</div>
