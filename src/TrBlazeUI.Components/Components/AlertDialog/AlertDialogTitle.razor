@namespace TrBlazeUI.Components.AlertDialog
@using TrBlazeUI.Components.Utilities
@using TrBlazeUI.Primitives.Dialog

@*
    Alert Dialog Title - the title text.
*@

<DialogTitle class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
</DialogTitle>

@code {
    /// <summary>
    /// The title text content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the title.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets the computed CSS classes for the title.
    /// </summary>
    private string CssClass => ClassNames.cn(
        "text-lg font-semibold",
        Class
    );

    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
