@namespace TrBlazeUI.Components.AlertDialog
@using TrBlazeUI.Components.Utilities
@using TrBlazeUI.Primitives.Dialog

@*
    Alert Dialog Content - the modal content panel.
    Mirrors shadcn/ui's AlertDialog: the overlay is inert (a confirmation is answered with an
    explicit action, not by clicking away) but Escape still cancels, and both halves are
    overridable via the Modal / CloseOnEscape parameters.
*@

<DialogPortal>
    <DialogOverlay CloseOnClick="@(!Modal)"
                   class="fixed inset-0 z-50 bg-black/80 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0" />

    <TrBlazeUI.Primitives.Dialog.DialogContent
        class="@GetClassNames()"
        CloseOnEscape="@CloseOnEscape"
        OnEscapeKeyDown="@OnEscapeKeyDown"
        TrapFocus="true"
        LockScroll="true"
        role="alertdialog"
        @attributes="AdditionalAttributes">
        @ChildContent
    </TrBlazeUI.Primitives.Dialog.DialogContent>
</DialogPortal>

@code {
    /// <summary>
    /// The content to render inside the alert dialog.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether pressing Escape cancels the alert dialog.
    /// Default is <c>true</c>, matching the shadcn/ui AlertDialog this mirrors.
    /// </summary>
    /// <remarks>
    /// Escape is observed on the document, so it also works when the dialog body has re-rendered
    /// (for example after a validation message appeared) and focus is no longer inside the panel.
    /// Set to <c>false</c> for a confirmation that must be answered by an explicit action, but
    /// then make sure a visible Cancel control is always reachable.
    /// </remarks>
    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// Whether the alert dialog is modal with respect to the overlay: when <c>true</c> (the
    /// default) clicking the dimmed backdrop does NOT dismiss it. Set to <c>false</c> to allow
    /// outside-click dismissal.
    /// </summary>
    /// <remarks>
    /// This covers overlay clicks only; Escape is controlled separately by
    /// <see cref="CloseOnEscape"/>. It is distinct from the Dialog primitive's own
    /// <c>Modal</c> parameter, which is a master switch over every form of light dismissal.
    /// </remarks>
    [Parameter]
    public bool Modal { get; set; } = true;

    /// <summary>
    /// Event callback invoked when Escape is pressed, before any dismissal happens.
    /// </summary>
    [Parameter]
    public EventCallback<KeyboardEventArgs> OnEscapeKeyDown { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the dialog content.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Additional attributes to apply to the dialog content.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the computed CSS classes for the alert dialog content.
    /// </summary>
    private string GetClassNames() => ClassNames.cn(
        // TR-014 hardening (see DialogContent): auto-margin centering inside a full-viewport
        // fixed box with intrinsic height — no translate/transform offsets — so a tall alert
        // dialog's top can never sit above y=0 regardless of any stray -50% offset stacking.
        "fixed inset-0 z-50 m-auto grid h-fit w-full max-w-lg",
        "max-h-[calc(100vh-2rem)] overflow-y-auto",
        "gap-4 border bg-background p-6 shadow-lg duration-200",
        "data-[state=open]:animate-in data-[state=closed]:animate-out",
        "data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0",
        "data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95",
        "sm:rounded-lg",
        Class
    );
}
