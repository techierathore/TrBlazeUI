@namespace TrBlazeUI.Components.AlertDialog
@using TrBlazeUI.Primitives.Dialog

@*
    Alert Dialog Action - the confirmation/action button.
    Closes the dialog when clicked, then runs OnClick.
*@

<DialogClose AsChild="@AsChild" OnClick="@OnClick" PreventClose="@PreventClose" @attributes="AdditionalAttributes">
    @ChildContent
</DialogClose>

@code {
    /// <summary>
    /// The content to render as the action button.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// When true, the action will not render a default button wrapper.
    /// Instead, the child component receives close behavior via cascading context.
    /// </summary>
    [Parameter]
    public bool AsChild { get; set; } = true;

    /// <summary>
    /// Gets or sets the handler run when the action is pressed, after the dialog has closed
    /// (or instead of closing it when <see cref="PreventClose"/> is true).
    /// </summary>
    /// <remarks>
    /// Until this parameter the action took only <c>ChildContent</c> and <c>AsChild</c>, so a
    /// delete confirmation had to put its handler on the inner <c>Button</c> (Sevak TR-044).
    /// The handler is awaited, in both the <c>AsChild</c> form and the rendered-button form.
    /// </remarks>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// Gets or sets whether pressing the action leaves the dialog open, so <see cref="OnClick"/>
    /// can decide (a delete that failed keeps the confirmation on screen). Default is false.
    /// </summary>
    [Parameter]
    public bool PreventClose { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
