@namespace TrBlazeUI.Components.AlertDialog
@using TrBlazeUI.Primitives.Dialog

@*
    Alert Dialog Cancel - the cancel button.
    Closes the dialog when clicked, then runs OnClick.
*@

<DialogClose AsChild="@AsChild" OnClick="@OnClick" PreventClose="@PreventClose" @attributes="AdditionalAttributes">
    @ChildContent
</DialogClose>

@code {
    /// <summary>
    /// The content to render as the cancel button.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// When true, the cancel will not render a default button wrapper.
    /// Instead, the child component receives close behavior via cascading context.
    /// </summary>
    [Parameter]
    public bool AsChild { get; set; } = true;

    /// <summary>
    /// Gets or sets the handler run when cancel is pressed, after the dialog has closed
    /// (or instead of closing it when <see cref="PreventClose"/> is true).
    /// </summary>
    /// <remarks>
    /// Added with <c>AlertDialogAction.OnClick</c> (Sevak TR-044) so both footer buttons take a
    /// handler the same way. The handler is awaited.
    /// </remarks>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// Gets or sets whether pressing cancel leaves the dialog open. Default is false.
    /// </summary>
    [Parameter]
    public bool PreventClose { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
