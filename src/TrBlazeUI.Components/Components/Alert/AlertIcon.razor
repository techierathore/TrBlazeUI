@namespace TrBlazeUI.Components.Alert

@if (AdditionalAttributes is { Count: > 0 })
{
    <span @attributes="AdditionalAttributes">@ChildContent</span>
}
else
{
    @ChildContent
}

@code {
    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers).
    /// </summary>
    /// <remarks>
    /// This component renders no wrapper of its own by default. When any attribute is supplied
    /// the content is wrapped in a <c>&lt;span&gt;</c> so the attributes have an element to land on.
    /// </remarks>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets or sets the icon content (e.g., a LucideIcon component).
    /// </summary>
    /// <remarks>
    /// <para>
    /// AlertIcon is an alternative to the <c>&lt;Alert.Icon&gt;</c> child content syntax
    /// that avoids the RZ10012 compiler warning. Place it inside an Alert component:
    /// </para>
    /// <code>
    /// &lt;Alert&gt;
    ///     &lt;AlertIcon&gt;&lt;LucideIcon Name="info" Size="16" /&gt;&lt;/AlertIcon&gt;
    ///     &lt;AlertTitle&gt;Heads up!&lt;/AlertTitle&gt;
    ///     &lt;AlertDescription&gt;Important message.&lt;/AlertDescription&gt;
    /// &lt;/Alert&gt;
    /// </code>
    /// </remarks>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
