@namespace TrBlazeUI.Components.Table
@using TrBlazeUI.Components.Utilities

@* Wraps the headless TrBlazeUI.Primitives.Table.TableCell, which needs no table context. *@
<TrBlazeUI.Primitives.Table.TableCell Class="@CssClass" @attributes="SlotAttributes">
    @ChildContent
</TrBlazeUI.Primitives.Table.TableCell>

@code {
    /// <summary>
    /// Gets or sets the cell content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes merged into the element's own.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered <c>td</c> element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => ClassNames.cn("p-4 align-middle", Class);

    private Dictionary<string, object> SlotAttributes => TableSlot.With("table-cell", AdditionalAttributes);
}
