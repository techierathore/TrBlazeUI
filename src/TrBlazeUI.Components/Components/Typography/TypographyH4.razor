@namespace TrBlazeUI.Components.Typography

<h4 class="@CssClass" @attributes="AdditionalAttributes">@ChildContent</h4>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets the rendered font size.
    /// </summary>
    /// <remarks>
    /// This REPLACES the component's default size classes rather than competing with them, so a
    /// smaller size works as reliably as a larger one. Leave at
    /// <see cref="TypographySize.Default"/> to keep the shadcn/ui type scale.
    /// </remarks>
    [Parameter]
    public TypographySize Size { get; set; } = TypographySize.Default;

    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "scroll-m-20 font-semibold tracking-tight",
        TypographySizes.ToClass(Size, "text-xl"),
        Class
    );

    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
