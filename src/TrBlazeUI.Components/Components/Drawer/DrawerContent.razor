@namespace TrBlazeUI.Components.Drawer
@using TrBlazeUI.Primitives.Services
@using Microsoft.JSInterop
@inject IFocusManager FocusManager
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Context?.IsOpen == true)
{
    @* Overlay *@
    <div class="fixed inset-0 z-50 bg-black/80 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0"
         data-state="open"
         @onclick="HandleOverlayClick">
    </div>

    @* Drawer Content *@
    <div @ref="objContentRef"
         class="@CssClass"
         data-state="open"
         role="dialog"
         aria-modal="true"
         tabindex="-1"
         @onkeydown="HandleKeyDown"
         @attributes="AdditionalAttributes">
        @if (ShowHandle)
        {
            <div class="mx-auto mt-4 h-2 w-[100px] rounded-full bg-muted"></div>
        }
        @ChildContent
    </div>
}

@code {
    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [CascadingParameter]
    public Drawer? Context { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool ShowHandle { get; set; } = true;

    [Parameter]
    public bool TrapFocus { get; set; } = true;

    [Parameter]
    public bool LockScroll { get; set; } = true;

    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    private ElementReference objContentRef;
    private IAsyncDisposable? objFocusTrap;
    private IJSObjectReference? objPortalModule;
    private IJSObjectReference? objScrollLockCleanup;
    private bool objIsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Context?.IsOpen == true && !objIsInitialized)
        {
            objIsInitialized = true;

            // Set up focus trap
            if (TrapFocus)
            {
                try
                {
                    objFocusTrap = await FocusManager.TrapFocusAsync(objContentRef);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Failed to set up focus trap: {ex.Message}");
                }
            }

            // Lock body scroll
            if (LockScroll)
            {
                try
                {
                    objPortalModule = await JS.InvokeAsync<IJSObjectReference>(
                        "import", "./_content/TrBlazeUI.Primitives/js/primitives/portal.js");
                    objScrollLockCleanup = await objPortalModule.InvokeAsync<IJSObjectReference>("lockBodyScroll");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Failed to lock body scroll: {ex.Message}");
                }
            }
        }
        else if (Context?.IsOpen != true && objIsInitialized)
        {
            await CleanupAsync();
        }
    }

    private async Task HandleOverlayClick()
    {
        if (Context != null)
        {
            await Context.SetOpenAsync(false);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && CloseOnEscape && Context != null)
        {
            await Context.SetOpenAsync(false);
        }
    }

    private async Task CleanupAsync()
    {
        // Dispose focus trap
        if (objFocusTrap != null)
        {
            try
            {
                await objFocusTrap.DisposeAsync();
            }
            catch
            {
                // Ignore disposal errors
            }
            objFocusTrap = null;
        }

        // Unlock body scroll
        if (objScrollLockCleanup != null)
        {
            try
            {
                await objScrollLockCleanup.InvokeVoidAsync("apply");
            }
            catch
            {
                // Cleanup may already be disposed
            }
            objScrollLockCleanup = null;
        }

        objIsInitialized = false;
    }

    public async ValueTask DisposeAsync()
    {
        await CleanupAsync();

        if (objPortalModule != null)
        {
            try
            {
                await objPortalModule.DisposeAsync();
            }
            catch
            {
                // Ignore disposal errors
            }
        }
    }

    private string DirectionClasses => Context?.Direction switch
    {
        DrawerDirection.Top => "inset-x-0 top-0 border-b data-[state=open]:slide-in-from-top data-[state=closed]:slide-out-to-top",
        DrawerDirection.Bottom => "inset-x-0 bottom-0 border-t data-[state=open]:slide-in-from-bottom data-[state=closed]:slide-out-to-bottom",
        DrawerDirection.Left => "inset-y-0 left-0 h-full w-3/4 border-r data-[state=open]:slide-in-from-left data-[state=closed]:slide-out-to-left sm:max-w-sm",
        DrawerDirection.Right => "inset-y-0 right-0 h-full w-3/4 border-l data-[state=open]:slide-in-from-right data-[state=closed]:slide-out-to-right sm:max-w-sm",
        _ => "inset-x-0 bottom-0 border-t data-[state=open]:slide-in-from-bottom data-[state=closed]:slide-out-to-bottom"
    };

    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "fixed z-50 gap-4 bg-background p-6 shadow-lg transition ease-in-out",
        "data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:duration-300 data-[state=open]:duration-500",
        DirectionClasses,
        Class
    );
}
