@namespace TrBlazeUI.Components.Drawer

@* Drawer - A mobile-friendly slide panel built on Sheet primitive *@
<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool? Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public bool DefaultOpen { get; set; }

    [Parameter]
    public DrawerDirection Direction { get; set; } = DrawerDirection.Bottom;

    internal bool IsControlled => Open.HasValue;
    internal bool IsOpen => Open ?? objInternalOpen;
    private bool objInternalOpen;

    internal async Task SetOpenAsync(bool open)
    {
        if (IsControlled)
        {
            await OpenChanged.InvokeAsync(open);
        }
        else
        {
            objInternalOpen = open;
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        objInternalOpen = DefaultOpen;
    }

    /// <summary>
    /// Gets or sets additional HTML attributes.
    /// </summary>
    /// <remarks>
    /// This component renders no element of its own - it only supplies a cascading context - so
    /// the attributes are accepted (never throwing) but are not emitted. Put the attribute on the
    /// component that renders the visible element instead.
    /// </remarks>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
