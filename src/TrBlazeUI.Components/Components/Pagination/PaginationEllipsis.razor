@namespace TrBlazeUI.Components.Pagination
@using TrBlazeUI.Icons.Lucide.Components

<span aria-hidden="true" class="@CssClass" @attributes="AdditionalAttributes">
    <LucideIcon Name="ellipsis" Class="h-4 w-4" />
    <span class="sr-only">More pages</span>
</span>

@code {
    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "flex h-10 w-10 items-center justify-center",
        Class
    );
}
