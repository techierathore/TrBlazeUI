@namespace TrBlazeUI.Components.Pagination
@using TrBlazeUI.Components.Select

<div class="@CssClass" @attributes="AdditionalAttributes">
    @if (ShowLabel)
    {
        <p class="text-sm font-medium">@Label</p>
    }
    <Select TValue="string"
            Value="@objPageSizeValue"
            ValueChanged="@HandlePageSizeChanged">
        <SelectTrigger Class="@TriggerCssClass">
            <SelectValue />
        </SelectTrigger>
        <SelectContent>
            @foreach (var size in EffectivePageSizes)
            {
                <SelectItem Value="@size.ToString()">@size</SelectItem>
            }
        </SelectContent>
    </Select>
</div>

@code {
    private string objPageSizeValue = "10";
    private bool objInitialized = false;

    [CascadingParameter]
    private PaginationContext? Context { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// CSS class for the Select trigger element.
    /// </summary>
    [Parameter]
    public string? TriggerClass { get; set; }

    /// <summary>
    /// Whether to show the label. Default: true
    /// </summary>
    [Parameter]
    public bool ShowLabel { get; set; } = true;

    /// <summary>
    /// Label text for the page size selector. Default: "Rows per page"
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "Rows per page";

    /// <summary>
    /// Override page sizes from context. When null, uses context's PageSizes.
    /// </summary>
    [Parameter]
    public int[]? PageSizes { get; set; }

    /// <summary>
    /// Custom callback when page size changes.
    /// </summary>
    [Parameter]
    public EventCallback<int> OnPageSizeChanged { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private int[] EffectivePageSizes => PageSizes ?? Context?.PageSizes ?? [10, 20, 50, 100];

    protected override void OnInitialized()
    {
        if (Context?.State != null)
            objPageSizeValue = Context.State.PageSize.ToString();
        objInitialized = true;
    }

    protected override void OnParametersSet()
    {
        if (objInitialized && Context?.State != null)
        {
            var currentPageSize = Context.State.PageSize.ToString();
            if (objPageSizeValue != currentPageSize)
                objPageSizeValue = currentPageSize;
        }
    }

    private async Task HandlePageSizeChanged(string newValue)
    {
        objPageSizeValue = newValue;

        if (int.TryParse(newValue, out var newSize))
        {
            if (Context?.State != null && newSize != Context.State.PageSize)
            {
                Context.State.PageSize = newSize;
                Context.State.CurrentPage = 1;

                if (Context.OnPageSizeChanged != null)
                    await Context.OnPageSizeChanged(newSize);
            }

            if (OnPageSizeChanged.HasDelegate)
                await OnPageSizeChanged.InvokeAsync(newSize);
        }
    }

    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "flex items-center gap-2",
        Class
    );

    private string TriggerCssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "h-8 w-[70px]",
        TriggerClass
    );
}
