@typeparam TValue
@namespace TrBlazeUI.Components.Select
@using TrBlazeUI.Primitives.Select
@attribute [CascadingTypeParameter(nameof(TValue))]

@* Styled Select wrapper around Select *@
<TrBlazeUI.Primitives.Select.Select TValue="TValue"
                 Value="@Value"
                 ValueChanged="@ValueChanged"
                 DefaultValue="@EffectiveDefaultValue"
                 @bind-Open="IsOpen"
                 Disabled="Disabled"
                 DisplayTextSelector="@DisplayTextSelector"
                 class="@CssClass" @attributes="AdditionalAttributes">
    @ChildContent
</TrBlazeUI.Primitives.Select.Select>

@code {
    /// <summary>
    /// Gets or sets the currently selected value.
    /// </summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the selected value changes.
    /// </summary>
    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>
    /// Gets or sets the initial value when the select is not controlled with <see cref="ValueChanged"/>.
    /// </summary>
    /// <remarks>
    /// When omitted, a one-way <see cref="Value"/> is used as the initial value, so callers do
    /// not need a dummy callback to preselect an item.
    /// </remarks>
    [Parameter]
    public TValue? DefaultValue { get; set; }

    /// <summary>
    /// Gets or sets whether the select is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets whether the dropdown is open (controlled mode).
    /// </summary>
    [Parameter]
    public bool? Open { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the open state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the select container.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Optional function to derive display text from the selected value.
    /// Use this when you have a pre-selected value and want to show its display text
    /// without waiting for the dropdown items to render and register.
    /// This keeps display text in sync automatically when the value changes.
    /// </summary>
    [Parameter]
    public Func<TValue, string>? DisplayTextSelector { get; set; }

    /// <summary>
    /// Gets or sets the content to be rendered inside the select component.
    /// Should contain SelectTrigger and SelectContent components.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool IsOpen { get; set; }

    private TValue? EffectiveDefaultValue => ValueChanged.HasDelegate ? DefaultValue : Value;

    /// <summary>
    /// Gets the computed CSS classes for the select container.
    /// </summary>
    private string CssClass => ClassNames.cn("relative", Class);

    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
