@namespace TrBlazeUI.Components.Select

@if (!string.IsNullOrWhiteSpace(GetSelectedText()))
{
    <span id="@GetValueId()" @attributes="AdditionalAttributes">@GetSelectedText()</span>
}
else
{
    <span id="@GetValueId()" class="text-muted-foreground" @attributes="AdditionalAttributes">@Placeholder</span>
}

@code {
    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [CascadingParameter]
    private dynamic? SelectContext { get; set; }

    /// <summary>
    /// Gets or sets the placeholder text to display when no value is selected.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Resolves the display text synchronously so the trigger has an accessible name
    /// from the very first render: registered display text first, then the raw bound
    /// value as a fallback while the items have not registered yet.
    /// </summary>
    /// <remarks>
    /// Sevak TR-024: once the items have registered and none of them carries the bound value,
    /// the raw value is not shown - an <c>int</c> select bound to 0 with items 1 to 5 read "0"
    /// where its placeholder belonged. A null value, or a value equal to its type's default,
    /// is "nothing selected" whenever no item matches it.
    /// </remarks>
    private string? GetSelectedText()
    {
        if (SelectContext == null)
        {
            return null;
        }

        string? vDisplayText = SelectContext.DisplayText;
        if (!string.IsNullOrWhiteSpace(vDisplayText))
        {
            return vDisplayText;
        }

        object? vValue = SelectContext.Value;
        if (vValue is null || IsDefaultValue(vValue))
        {
            return null;
        }

        int vRegistered = SelectContext.RegisteredItemCount;
        if (vRegistered > 0)
        {
            bool vHasItem = SelectContext.HasItemWithValue(vValue);
            if (!vHasItem)
            {
                return null;
            }
        }

        return vValue.ToString();
    }

    private static bool IsDefaultValue(object aValue)
    {
        var vType = aValue.GetType();
        return vType.IsValueType && Equals(aValue, Activator.CreateInstance(vType));
    }

    /// <summary>
    /// Gets the scoped id for the value element so it can be referenced via aria-labelledby.
    /// </summary>
    private string? GetValueId() => SelectContext?.ValueId;
}
