@namespace TrBlazeUI.Components.Select

@if (!string.IsNullOrWhiteSpace(GetSelectedText()))
{
    <span id="@GetValueId()">@GetSelectedText()</span>
}
else
{
    <span id="@GetValueId()" class="text-muted-foreground">@Placeholder</span>
}

@code {
    [CascadingParameter]
    private dynamic? SelectContext { get; set; }

    /// <summary>
    /// Gets or sets the placeholder text to display when no value is selected.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Resolves the display text synchronously so the trigger has an accessible name
    /// from the very first render: registered display text first, then the raw bound
    /// value as a fallback (items may not have registered yet).
    /// </summary>
    private string? GetSelectedText()
    {
        if (SelectContext == null)
        {
            return null;
        }

        string? vDisplayText = SelectContext.DisplayText;
        if (!string.IsNullOrWhiteSpace(vDisplayText))
        {
            return vDisplayText;
        }

        object? vValue = SelectContext.Value;
        return vValue?.ToString();
    }

    /// <summary>
    /// Gets the scoped id for the value element so it can be referenced via aria-labelledby.
    /// </summary>
    private string? GetValueId() => SelectContext?.ValueId;
}
