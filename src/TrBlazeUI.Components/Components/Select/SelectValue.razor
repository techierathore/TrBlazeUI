@namespace TrBlazeUI.Components.Select

@if (!string.IsNullOrWhiteSpace(GetSelectedText()))
{
    <span id="@GetValueId()" @attributes="AdditionalAttributes">@GetSelectedText()</span>
}
else
{
    <span id="@GetValueId()" class="text-muted-foreground" @attributes="AdditionalAttributes">@Placeholder</span>
}

@code {
    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The parent Select's context, received through its non-generic interface: this component has no
    /// TValue of its own, and a <c>dynamic</c> lookup here threw RuntimeBinderException (TechieBlog TR-077).
    /// </summary>
    [CascadingParameter]
    private TrBlazeUI.Primitives.Select.ISelectValueDisplay? SelectContext { get; set; }

    /// <summary>
    /// Gets or sets the placeholder text to display when no value is selected.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Resolves the display text synchronously so the trigger has an accessible name from the very
    /// first render. The rules (Sevak TR-024, TechieBlog TR-077) live in the typed context:
    /// <see cref="TrBlazeUI.Primitives.Select.SelectContext{TValue}.ResolveDisplayText"/>.
    /// </summary>
    private string? GetSelectedText() => SelectContext?.ResolveDisplayText();

    /// <summary>
    /// Gets the scoped id for the value element so it can be referenced via aria-labelledby.
    /// </summary>
    private string? GetValueId() => SelectContext?.ValueId;
}
