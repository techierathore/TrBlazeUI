@namespace TrBlazeUI.Components.Command
@using TrBlazeUI.Components.Utilities
@implements IDisposable
@inject IJSRuntime JS

@* CommandItem - selectable item in the command list *@
@if (objIsVisible)
{
    <div id="@objItemId"
         role="option"
         aria-selected="@(objIsFocused ? "true" : "false")"
         aria-disabled="@(Disabled ? "true" : "false")"
         data-focused="@(objIsFocused ? "true" : "false")"
         data-disabled="@(Disabled ? "true" : "false")"
         @onclick="HandleClick"
         @onmouseenter="HandleMouseEnter"
         @onmousemove="HandleMouseMove"
         class="@CssClass">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter]
    public CommandContext? Context { get; set; }

    [CascadingParameter(Name = "CommandGroupId")]
    public string? GroupId { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the item.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets the content to be rendered inside the item.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the value associated with this item.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Gets or sets whether this item is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when this item is selected.
    /// </summary>
    [Parameter]
    public EventCallback OnSelect { get; set; }

    /// <summary>
    /// Gets or sets the text used for search filtering. If not provided, uses Value.
    /// </summary>
    [Parameter]
    public string? SearchText { get; set; }

    private int objIndex = -1;
    private int objFilteredIndex = -1;
    private string objItemId = string.Empty;
    private bool objIsFocused;
    private bool objIsVisible = true;
    private bool objShouldScrollIntoView;

    /// <summary>
    /// Gets the computed CSS classes for the item.
    /// </summary>
    private string CssClass => ClassNames.cn(
        "relative flex cursor-pointer select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none",
        !Disabled && Context?.IsKeyboardNavigating != true ? "hover:bg-accent hover:text-accent-foreground" : null,
        Disabled ? "opacity-50 cursor-not-allowed" : null,
        objIsFocused ? "bg-accent text-accent-foreground" : null,
        Class
    );

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException($"{nameof(CommandItem)} must be used within a {nameof(Command)} component.");
        }

        // Register with context
        objIndex = Context.RegisterItem(
            value: Value,
            searchText: SearchText ?? Value ?? string.Empty,
            disabled: Disabled,
            onSelect: OnSelect,
            groupId: GroupId
        );

        objItemId = Context.GetItemId(objIndex);

        // Subscribe to targeted events for better performance
        Context.OnFocusChanged += HandleFocusChanged;
        Context.OnSearchChanged += HandleSearchChanged;
        Context.OnKeyboardNavigationChanged += HandleKeyboardNavigationChanged;

        // Initial visibility check
        UpdateVisibilityAndFilteredIndex();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        // Update registration when parameters change
        if (objIndex >= 0 && Context != null)
        {
            Context.UpdateItem(
                index: objIndex,
                value: Value,
                searchText: SearchText ?? Value ?? string.Empty,
                disabled: Disabled,
                onSelect: OnSelect,
                groupId: GroupId
            );
        }
    }

    private async Task HandleClick()
    {
        if (Disabled || Context == null) return;

        await Context.SelectItemByValueAsync(Value ?? string.Empty);
    }

    private void HandleMouseMove()
    {
        // Re-enable hover focus when mouse actually moves
        Context?.OnMouseMove();
    }

    private void HandleMouseEnter()
    {
        // Ignore hover during keyboard navigation
        if (Context?.IsKeyboardNavigating == true) return;

        if (Disabled || Context == null || !objIsVisible) return;

        // Use cached filtered index if available, otherwise calculate it
        if (objFilteredIndex >= 0)
        {
            Context.SetFocusedIndex(objFilteredIndex);
        }
    }

    private void HandleFocusChanged(int previousIndex, int newIndex)
    {
        // Only re-render if this item is affected by the focus change
        if (objFilteredIndex == previousIndex || objFilteredIndex == newIndex)
        {
            var wasFocused = objIsFocused;
            objIsFocused = objFilteredIndex == newIndex;

            // Scroll into view only during keyboard navigation, not mouse hover
            if (objIsFocused && !wasFocused && Context?.IsKeyboardNavigating == true)
            {
                objShouldScrollIntoView = true;
            }

            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (objShouldScrollIntoView && objIsFocused)
        {
            objShouldScrollIntoView = false;
            try
            {
                // Use 'nearest' to scroll only if item is out of view, avoiding page jumps
                var elementUtilsModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/TrBlazeUI.Primitives/js/primitives/element-utils.js");
                await elementUtilsModule.InvokeVoidAsync("scrollIntoView", objItemId, "nearest", "instant");
                await elementUtilsModule.DisposeAsync();
            }
            catch
            {
                // Ignore JS errors during scroll
            }
        }
    }

    private void HandleSearchChanged()
    {
        // Update visibility and filtered index when search changes
        UpdateVisibilityAndFilteredIndex();

        // Reset focused state since search changed
        objIsFocused = false;

        StateHasChanged();
    }

    private void HandleKeyboardNavigationChanged(bool isKeyboardNavigating)
    {
        // Re-render to update hover classes
        StateHasChanged();
    }

    private void UpdateVisibilityAndFilteredIndex()
    {
        if (Context == null)
        {
            objIsVisible = false;
            objFilteredIndex = -1;
            return;
        }

        var thisItem = Context.GetItemByIndex(objIndex);
        if (thisItem == null)
        {
            objIsVisible = false;
            objFilteredIndex = -1;
            return;
        }

        // Check if item passes filter
        if (string.IsNullOrWhiteSpace(Context.SearchQuery))
        {
            objIsVisible = true;
        }
        else if (Context.FilterFunction != null)
        {
            objIsVisible = Context.FilterFunction(thisItem, Context.SearchQuery);
        }
        else
        {
            objIsVisible = thisItem.SearchText?.Contains(Context.SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false;
        }

        // Update filtered index for efficient focus handling
        if (objIsVisible)
        {
            var filteredItems = Context.GetFilteredItems();
            objFilteredIndex = filteredItems.IndexOf(thisItem);
        }
        else
        {
            objFilteredIndex = -1;
        }
    }

    public void Dispose()
    {
        if (Context != null && objIndex >= 0)
        {
            Context.UnregisterItem(objIndex);
            Context.OnFocusChanged -= HandleFocusChanged;
            Context.OnSearchChanged -= HandleSearchChanged;
            Context.OnKeyboardNavigationChanged -= HandleKeyboardNavigationChanged;
        }
    }
}
