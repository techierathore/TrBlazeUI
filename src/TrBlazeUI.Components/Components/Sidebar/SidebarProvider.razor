@namespace TrBlazeUI.Components.Sidebar
@using TrBlazeUI.Components.Tooltip
@implements IAsyncDisposable

@*
    SidebarProvider component that manages sidebar state, persistence, and responsive behavior.
    Wraps the entire application or page layout to provide sidebar context.
*@

<TooltipProvider @attributes="AdditionalAttributes">
    <CascadingValue Value="@Context" IsFixed="false">
        <div class="@($"flex w-full {HeightClass}")" style="@WidthStyle">
            @ChildContent
        </div>
    </CascadingValue>
</TooltipProvider>

@code {
    /// <summary>
    /// The content to render inside the sidebar provider.
    /// Should typically contain SidebarLayout with Sidebar and SidebarInset.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Default open state for the sidebar on desktop.
    /// </summary>
    [Parameter]
    public bool DefaultOpen { get; set; } = true;

    /// <summary>
    /// The sidebar variant/style.
    /// </summary>
    [Parameter]
    public SidebarVariant Variant { get; set; } = SidebarVariant.Sidebar;

    /// <summary>
    /// Which side the sidebar appears on.
    /// </summary>
    [Parameter]
    public SidebarSide Side { get; set; } = SidebarSide.Left;

    /// <summary>
    /// Cookie key for persisting sidebar state.
    /// Set to null to disable persistence.
    /// </summary>
    [Parameter]
    public string? CookieKey { get; set; } = "sidebar:state";

    /// <summary>
    /// CSS class for controlling the container height.
    /// Defaults to "min-h-screen" to fill viewport and grow with content.
    /// Can be set to "h-screen" for fixed viewport height or "h-full" for contained layouts.
    /// </summary>
    [Parameter]
    public string HeightClass { get; set; } = "min-h-screen";

    /// <summary>
    /// Width of the expanded desktop sidebar column, as any CSS length (for example "18rem").
    /// Leave null to use the stylesheet's <c>--sidebar-width</c> (16rem).
    /// </summary>
    /// <remarks>
    /// Sets <c>--sidebar-width</c> on the provider's own element, so it applies to this shell only
    /// and a host that themes the token globally is unaffected (TfLens TR-035).
    /// </remarks>
    [Parameter]
    public string? Width { get; set; }

    /// <summary>
    /// Width of the slid-out phone menu, as any CSS length (for example "20rem").
    /// Leave null to use the stylesheet's <c>--sidebar-width-mobile</c> (18rem).
    /// </summary>
    [Parameter]
    public string? MobileWidth { get; set; }

    /// <summary>
    /// Width of the collapsed icon rail, as any CSS length (for example "3.5rem").
    /// Leave null to use the stylesheet's <c>--sidebar-width-icon</c> (3rem).
    /// </summary>
    [Parameter]
    public string? IconWidth { get; set; }

    /// <summary>
    /// Gets the inline custom-property declarations for whichever widths the caller supplied.
    /// Returns null when none were, so the element carries no style attribute at all.
    /// </summary>
    private string? WidthStyle
    {
        get
        {
            var vParts = new List<string>(3);

            if (!string.IsNullOrWhiteSpace(Width))
            {
                vParts.Add($"--sidebar-width:{Width}");
            }

            if (!string.IsNullOrWhiteSpace(MobileWidth))
            {
                vParts.Add($"--sidebar-width-mobile:{MobileWidth}");
            }

            if (!string.IsNullOrWhiteSpace(IconWidth))
            {
                vParts.Add($"--sidebar-width-icon:{IconWidth}");
            }

            return vParts.Count == 0 ? null : string.Join(';', vParts);
        }
    }
}
