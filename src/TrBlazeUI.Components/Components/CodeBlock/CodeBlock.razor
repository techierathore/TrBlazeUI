@namespace TrBlazeUI.Components.CodeBlock
@using TrBlazeUI.Components.Button
@implements IAsyncDisposable
@inject IJSRuntime JS

@* A monochrome code block with an optional language label and copy button. It deliberately does
   NOT bundle a syntax highlighter - that is an application choice, and shipping one would drag a
   large JS dependency into every consumer. Pass pre-highlighted HTML through Html when you have
   one; otherwise the plain text form below is safe by construction. *@

<div class="@CssClass" data-slot="code-block" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Language) || ShowCopyButton)
    {
        <div class="flex items-center justify-between border-b border-border bg-muted/50 px-3 py-1.5">
            <span class="font-mono text-xs text-muted-foreground">@Language</span>
            @if (ShowCopyButton)
            {
                <Button Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Small"
                        Class="h-6 px-2 text-xs"
                        AriaLabel="@objCopyAriaLabel"
                        OnClick="CopyAsync"
                        @attributes="CopyButtonAttributes">
                    @objCopyLabel
                </Button>
            }
        </div>
    }
    <pre class="overflow-x-auto p-4 text-sm leading-relaxed"><code class="font-mono">@if (Html != null)
{
    @Html
}
else
{
    @Code
}</code></pre>
    <span class="sr-only" aria-live="polite">@objAnnouncement</span>
</div>

@code {
    private IJSObjectReference? objModule;
    private CodeBlockCopyResult? objCopyResult;

    private string objCopyLabel => objCopyResult switch
    {
        CodeBlockCopyResult.Copied => "Copied",
        CodeBlockCopyResult.Failed => "Press Ctrl+C",
        _ => CopyLabel ?? "Copy"
    };

    private string objCopyAriaLabel => objCopyResult switch
    {
        CodeBlockCopyResult.Copied => "Code copied",
        CodeBlockCopyResult.Failed => "Copying is unavailable here - select the code and press Ctrl+C",
        _ => CopyLabel ?? "Copy code"
    };

    private string? objAnnouncement => objCopyResult switch
    {
        CodeBlockCopyResult.Copied => "Code copied to clipboard",
        CodeBlockCopyResult.Failed => "Copying is not available here - select the code and press Ctrl+C",
        _ => null
    };

    /// <summary>
    /// Gets or sets the code to display.
    /// </summary>
    [Parameter]
    public string? Code { get; set; }

    /// <summary>
    /// Gets or sets pre-highlighted markup to display instead of <see cref="Code"/>.
    /// </summary>
    /// <remarks>
    /// Only pass markup you produced yourself or have sanitised - it is rendered as-is.
    /// <see cref="Code"/> is still used as the text the copy button writes to the clipboard.
    /// </remarks>
    [Parameter]
    public MarkupString? Html { get; set; }

    /// <summary>
    /// Gets or sets the language label shown in the header, for example <c>"csharp"</c>.
    /// </summary>
    [Parameter]
    public string? Language { get; set; }

    /// <summary>
    /// Gets or sets whether the copy button is shown. Default is true.
    /// </summary>
    [Parameter]
    public bool ShowCopyButton { get; set; } = true;

    /// <summary>
    /// Gets or sets the copy button's text before a copy, for example a translated "Copy".
    /// </summary>
    /// <remarks>
    /// When set it is also the button's accessible name (<c>aria-label</c>), so a screen reader hears
    /// the same translated word. Default: the text "Copy" with the accessible name "Copy code"
    /// (Sevak TR-047). An <c>aria-label</c> in <see cref="CopyButtonAttributes"/> still wins.
    /// </remarks>
    [Parameter]
    public string? CopyLabel { get; set; }

    /// <summary>
    /// Gets or sets attributes placed on the copy button itself, for example
    /// <c>data-testid</c>, <c>title</c> or <c>aria-label</c>.
    /// </summary>
    /// <remarks>
    /// <see cref="AdditionalAttributes"/> lands on the block's root element; this lands on the
    /// button. These are written after the component's own attributes, so an <c>aria-label</c> here
    /// replaces the built-in one in every state (Sevak TR-047).
    /// </remarks>
    [Parameter]
    public IReadOnlyDictionary<string, object>? CopyButtonAttributes { get; set; }

    /// <summary>
    /// Gets or sets the callback raised after each copy attempt, with its outcome.
    /// </summary>
    /// <remarks>
    /// Raised with <see cref="CodeBlockCopyResult.Copied"/> or <see cref="CodeBlockCopyResult.Failed"/>
    /// after the button has updated, so a page can show its own message (a toast, say) in its own
    /// language. Not raised when the copy never ran: during prerendering, or while a Blazor Server
    /// circuit is disconnecting (Sevak TR-047).
    /// </remarks>
    [Parameter]
    public EventCallback<CodeBlockCopyResult> OnCopied { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => TrBlazeUI.Components.Utilities.ClassNames.cn(
        "relative w-full overflow-hidden rounded-md border border-border bg-muted/30",
        Class
    );

    /// <summary>
    /// Copies <see cref="Code"/> to the clipboard and reports the outcome.
    /// </summary>
    /// <remarks>
    /// 1. Ask the browser to copy; a refusal or a script error is <see cref="CodeBlockCopyResult.Failed"/>.
    /// 2. A copy that never ran (disconnect, prerender) changes nothing and reports nothing.
    /// 3. Otherwise update the button, then raise <see cref="OnCopied"/> with the outcome.
    /// </remarks>
    /// <returns>A task that completes once the outcome has been reported.</returns>
    private async Task CopyAsync()
    {
        var vResult = await TryCopyAsync();
        if (vResult is null)
        {
            return;
        }

        objCopyResult = vResult;
        await OnCopied.InvokeAsync(vResult.Value);
    }

    /// <summary>
    /// Runs the copy through the clipboard script.
    /// </summary>
    /// <returns>The outcome, or null when the copy could not run at all.</returns>
    private async Task<CodeBlockCopyResult?> TryCopyAsync()
    {
        try
        {
            objModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/TrBlazeUI.Components/js/code-block.js");

            var vCopied = await objModule.InvokeAsync<bool>("copyText", Code ?? string.Empty);
            return vCopied ? CodeBlockCopyResult.Copied : CodeBlockCopyResult.Failed;
        }
        catch (JSException)
        {
            // The browser refused. Tell the user rather than failing silently.
            return CodeBlockCopyResult.Failed;
        }
        catch (JSDisconnectedException)
        {
            // Expected during circuit disconnect in Blazor Server.
            return null;
        }
        catch (InvalidOperationException)
        {
            // JS interop is unavailable during prerendering.
            return null;
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (objModule != null)
        {
            try
            {
                await objModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Expected during circuit disconnect.
            }
            catch (TaskCanceledException)
            {
                // The page went away before it answered; the module died with it (REQ-UI-028).
            }
        }

        GC.SuppressFinalize(this);
    }
}
