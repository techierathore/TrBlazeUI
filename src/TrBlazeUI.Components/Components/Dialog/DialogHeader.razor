@namespace TrBlazeUI.Components.Dialog

@*
    DialogHeader helper component for organizing dialog title and description.
*@

<div class="@GetClassNames()" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>
    /// The content to display in the dialog header (typically DialogTitle and DialogDescription).
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the header container.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    private string GetClassNames()
    {
        var classes = new List<string>
        {
            "flex",
            "flex-col",
            // TR-019: DialogContent is a column flex panel. Without shrink-0 the header would
            // give up height (down to its min-content size) instead of the DialogBody scrolling,
            // and the title would compress out of view on a short viewport.
            "shrink-0",
            "space-y-1.5",
            "text-center",
            "sm:text-left"
        };

        if (!string.IsNullOrWhiteSpace(Class))
        {
            classes.Add(Class);
        }

        return string.Join(" ", classes);
    }

    /// <summary>
    /// Gets or sets additional HTML attributes (id, style, data-*, aria-*, event handlers)
    /// forwarded to the rendered root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
