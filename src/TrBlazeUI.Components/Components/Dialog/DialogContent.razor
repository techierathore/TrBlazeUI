@namespace TrBlazeUI.Components.Dialog
@using TrBlazeUI.Components.Utilities
@using TrBlazeUI.Primitives.Dialog
@using TrBlazeUI.Icons.Lucide.Components

@*
    Styled DialogContent component with shadcn/ui classes.
    Includes overlay, dialog box, and close button.
*@

<DialogPortal>
    <DialogOverlay class="fixed inset-0 z-50 bg-black/80 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0" />

    <TrBlazeUI.Primitives.Dialog.DialogContent
        class="@GetClassNames()"
        CloseOnEscape="@CloseOnEscape"
        TrapFocus="@TrapFocus"
        LockScroll="@LockScroll"
        OnEscapeKeyDown="@OnEscapeKeyDown"
        @attributes="AdditionalAttributes">
        @ChildContent

        @if (ShowClose)
        {
            @* Absolutely positioned against the panel (the panel is `fixed`, so it is the
               containing block) and out of the flex flow, so it does not consume a row.
               With a DialogBody present the panel itself never scrolls, so this stays pinned
               to the panel's top-right; z-10 keeps it above scrolled body content. *@
            <TrBlazeUI.Primitives.Dialog.DialogClose class="absolute right-4 top-4 z-10 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none data-[state=open]:bg-accent data-[state=open]:text-muted-foreground">
                <LucideIcon Name="x" Class="h-4 w-4" />
                <span class="sr-only">Close</span>
            </TrBlazeUI.Primitives.Dialog.DialogClose>
        }
    </TrBlazeUI.Primitives.Dialog.DialogContent>
</DialogPortal>

@code {
    /// <summary>
    /// The content to render inside the dialog.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the dialog content.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Additional attributes to apply to the dialog content.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Whether to show the close button (X icon).
    /// Default is true.
    /// </summary>
    [Parameter]
    public bool ShowClose { get; set; } = true;

    /// <summary>
    /// Whether pressing Escape should close the dialog.
    /// Default is true.
    /// </summary>
    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// Whether to trap focus within the dialog.
    /// Default is true for modal dialogs.
    /// </summary>
    [Parameter]
    public bool TrapFocus { get; set; } = true;

    /// <summary>
    /// Whether to lock body scroll when dialog is open.
    /// Default is true for modal dialogs.
    /// </summary>
    [Parameter]
    public bool LockScroll { get; set; } = true;

    /// <summary>
    /// Event callback invoked when Escape key is pressed.
    /// </summary>
    [Parameter]
    public EventCallback<KeyboardEventArgs> OnEscapeKeyDown { get; set; }

    /// <summary>
    /// Tailwind max-height utility that caps the panel inside the viewport.
    /// Defaults to <c>max-h-[calc(100vh-2rem)]</c>, which leaves a 1rem gutter top and bottom.
    /// </summary>
    /// <remarks>
    /// The class must already exist in the library's pre-built stylesheet
    /// (<c>_content/TrBlazeUI.Components/trblazeui.css</c>) - an arbitrary value that was never
    /// emitted fails silently at runtime and the panel becomes unbounded. Utilities known to
    /// ship include the <c>max-h-*</c> scale (for example <c>max-h-96</c>, <c>max-h-screen</c>)
    /// plus the arbitrary values <c>max-h-[70vh]</c>, <c>max-h-[300px]</c>,
    /// <c>max-h-[400px]</c> and the default above.
    /// </remarks>
    [Parameter]
    public string MaxHeight { get; set; } = "max-h-[calc(100vh-2rem)]";

    /// <summary>
    /// Gets the computed CSS classes for the dialog content.
    /// Uses the cn() utility for intelligent class merging and Tailwind conflict resolution.
    /// </summary>
    private string GetClassNames() => ClassNames.cn(
        // TR-014 hardening: center the dialog with AUTO MARGINS inside a full-viewport fixed
        // box (`inset-0 m-auto`) with an intrinsic height (`h-fit`) — NOT translate/transform
        // offsets. Auto margins are never negative, so combined with the max-height cap below
        // the top can never sit above y=0 no matter how many stray -50% transform/translate
        // offsets a consumer stylesheet (or a future refactor) contributes. This removes the
        // whole class of clipping bug AstroLyfe reported (transform + translate stacking),
        // rather than relying on there being exactly one offset for the height cap to absorb.
        //
        // TR-019: the panel is a COLUMN FLEX box, not a plain grid. That is what lets a
        // DialogBody shrink (min-h-0) and scroll on its own while DialogHeader/DialogFooter
        // (shrink-0) stay pinned. Flex is used rather than `grid-rows-[auto_1fr_auto]` for two
        // reasons: that arbitrary utility is not in the pre-built stylesheet (it would fail
        // silently), and fixed template rows misplace content whenever a consumer's panel has
        // more or fewer than three children.
        "fixed inset-0 z-50 m-auto flex flex-col h-fit w-full max-w-lg",
        // Clamp inside the visual viewport so a tall dialog scrolls internally instead of
        // overflowing; with auto-margin centering the top stays >= gutter at any height.
        MaxHeight,
        // Kept on the panel for backward compatibility: a DialogContent WITHOUT a DialogBody has
        // nothing that can shrink, so the panel scrolls itself exactly as it did for REQ-UI-016
        // and the footer stays reachable. With a DialogBody the body absorbs the overflow and
        // this never engages.
        "overflow-y-auto",
        "gap-4 border bg-background p-6 shadow-lg duration-200",
        // Enter/exit is zoom + fade only (no slide) — the slide utilities were built around
        // the old -50% translate base and are unnecessary for an auto-margin-centered box.
        "data-[state=open]:animate-in data-[state=closed]:animate-out",
        "data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0",
        "data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95",
        "sm:rounded-lg",
        Class
    );
}
