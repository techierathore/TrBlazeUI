@typeparam TValue
@namespace TrBlazeUI.Components.RadioGroup
@using TrBlazeUI.Primitives.RadioGroup

<TrBlazeUI.Primitives.RadioGroup.RadioGroup TValue="TValue"
    Value="@Value"
    ValueChanged="@HandleValueChanged"
    Disabled="@Disabled"
    AriaLabel="@AriaLabel"
    class="@CssClass"
    aria-invalid="@(IsInvalid ? "true" : null)">
    @ChildContent
</TrBlazeUI.Primitives.RadioGroup.RadioGroup>
