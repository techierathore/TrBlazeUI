<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NOTE (TR-011): AddRazorSupportForMvc is deliberately NOT set. Headless Blazor
         primitives (.razor only) must stay consumable from MAUI Blazor Hybrid heads on every
         TFM; enabling MVC Razor support pulls a build-time dependency on the
         Microsoft.AspNetCore.App shared framework (unsatisfiable on Mac Catalyst/iOS/Android ->
         NETSDK1082). Microsoft.AspNetCore.Components.Web (below) covers everything used. -->

    <!-- NuGet Package Configuration -->
    <PackageId>TrBlazeUI.Primitives</PackageId>
    <RootNamespace>TrBlazeUI.Primitives</RootNamespace>
    <AssemblyName>TrBlazeUI.Primitives</AssemblyName>
    <Description>Headless, unstyled Blazor primitive components with full accessibility support. Build your own component library using these composable primitives.</Description>
    <PackageTags>blazor;primitives;headless;ui;components;accessibility;radix;unstyled;wcag</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- <PackageIcon>icon.png</PackageIcon> -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>TrBlazeUI Contributors</Authors>
    <Copyright>Copyright (c) 2025-present TrBlazeUI Contributors</Copyright>

    <!-- Suppress CA1716: 'Select' namespace matches a keyword but is a domain term -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
