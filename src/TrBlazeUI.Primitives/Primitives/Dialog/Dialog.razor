@namespace TrBlazeUI.Primitives.Dialog
@inject TrBlazeUI.Primitives.Services.IPortalService PortalService

@* Dialog primitive root component - headless, unstyled behavior only *@
<CascadingValue Value="@objContext" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    private DialogContext objContext = new();
    private UseControllableState<bool> objState = null!;

    [CascadingParameter(Name = "TrBlazeUIPortalId")]
    private string? ContainingPortalId { get; set; }

    /// <summary>
    /// The child content to render within the dialog context.
    /// Typically includes DialogTrigger, DialogPortal, and other dialog parts.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Controls whether the dialog is open (controlled mode).
    /// When null, the dialog manages its own state (uncontrolled mode).
    /// </summary>
    [Parameter]
    public bool? Open { get; set; }

    /// <summary>
    /// Event callback invoked when the open state changes.
    /// Use with @bind-Open for two-way binding.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// Default open state when in uncontrolled mode.
    /// </summary>
    [Parameter]
    public bool DefaultOpen { get; set; } = false;

    /// <summary>
    /// Event callback invoked when the dialog open state changes.
    /// Receives the new open state as a parameter.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnOpenChange { get; set; }

    /// <summary>
    /// Whether the dialog can be dismissed by clicking outside or pressing Escape.
    /// Default is true.
    /// </summary>
    [Parameter]
    public bool Modal { get; set; } = true;

    protected override void OnInitialized()
    {
        // Initialize controllable state
        objState = new UseControllableState<bool>(DefaultOpen)
        {
            ControlledValue = Open.HasValue ? Open.Value : DefaultOpen,
            OnValueChanged = OpenChanged,
            IsControlled = OpenChanged.HasDelegate
        };

        // Sync initial state to context
        objContext.State.IsOpen = objState.Value;

        // Subscribe to context state changes
        objContext.OnStateChanged += HandleContextStateChanged;
    }

    protected override void OnParametersSet()
    {
        // Update controlled value if it changed
        if (objState.IsControlled && Open.HasValue)
        {
            objState.ControlledValue = Open.Value;
            objContext.State.IsOpen = Open.Value;
        }
    }

    private void HandleContextStateChanged()
    {
        // When context state changes (e.g., from DialogTrigger or DialogClose),
        // update the controllable state
        var newOpenState = objContext.State.IsOpen;

        if (objState.Value != newOpenState)
        {
            _ = objState.SetValueAsync(newOpenState);

            // Invoke additional callback if provided
            if (OnOpenChange.HasDelegate)
            {
                _ = OnOpenChange.InvokeAsync(newOpenState);
            }

            StateHasChanged();
        }

        // A nested Dialog is already an attached component within the containing portal.
        // Rebuilding that portal here can dispose its DialogPortal before the open notification
        // registers the child surface; the local render plus DialogPortal's context subscription
        // are sufficient.
    }

    public void Dispose()
    {
        objContext.OnStateChanged -= HandleContextStateChanged;
    }

    /// <summary>
    /// Gets or sets additional HTML attributes.
    /// </summary>
    /// <remarks>
    /// This component renders no element of its own - it only supplies a cascading context - so
    /// the attributes are accepted (never throwing) but are not emitted. Put the attribute on the
    /// component that renders the visible element instead.
    /// </remarks>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
