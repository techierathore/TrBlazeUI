@namespace TrBlazeUI.Primitives.Tooltip
@implements IDisposable

@* Tooltip Primitive - Headless root component *@
<CascadingValue Value="@objContext" IsFixed="false">
    <div class="@Class" @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private TooltipContext objContext = new();
    private UseControllableState<bool> objState = null!;
    private System.Timers.Timer? objShowTimer;
    private System.Timers.Timer? objHideTimer;
    private bool objDisposed;

    /// <summary>
    /// Additional attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Additional CSS classes to apply to the root element.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The child content to render inside the tooltip container.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Controls whether the tooltip is open (controlled mode).
    /// When null, the tooltip manages its own state (uncontrolled mode).
    /// </summary>
    [Parameter]
    public bool? Open { get; set; }

    /// <summary>
    /// Event callback invoked when the open state changes.
    /// Use with @bind-Open for two-way binding.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// Default open state when in uncontrolled mode.
    /// </summary>
    [Parameter]
    public bool DefaultOpen { get; set; } = false;

    /// <summary>
    /// The delay in milliseconds before showing the tooltip. Default is 700ms.
    /// </summary>
    [Parameter]
    public int DelayDuration { get; set; } = 700;

    /// <summary>
    /// The delay in milliseconds before hiding the tooltip after mouse leaves. Default is 0ms (immediate).
    /// </summary>
    [Parameter]
    public int HideDelay { get; set; } = 0;

    /// <summary>
    /// The placement position for the tooltip. Default is "top".
    /// </summary>
    [Parameter]
    public string Placement { get; set; } = "top";

    protected override void OnInitialized()
    {
        // Initialize controllable state
        objState = new UseControllableState<bool>(DefaultOpen)
        {
            ControlledValue = Open.HasValue ? Open.Value : DefaultOpen,
            OnValueChanged = OpenChanged,
            IsControlled = OpenChanged.HasDelegate
        };

        // Initialize context with closed state (don't sync objState.Value yet)
        objContext.State.IsOpen = false;
        objContext.State.Placement = Placement;

        // Subscribe to context state changes
        objContext.OnStateChanged += HandleContextStateChanged;

        // If initial state is open, apply it with delay
        if (objState.Value)
        {
            _ = SetOpenWithDelayAsync(true);
        }
    }

    protected override void OnParametersSet()
    {
        // Update controlled value if it changed
        if (objState.IsControlled && Open.HasValue)
        {
            objState.ControlledValue = Open.Value;
            objContext.State.IsOpen = Open.Value;
        }

        // Update placement if changed
        if (objContext.State.Placement != Placement)
        {
            objContext.SetPlacement(Placement);
        }
    }

    private void HandleContextStateChanged()
    {
        // When context state changes (e.g., from TooltipTrigger),
        // capture the intent and reset state immediately to prevent premature rendering
        var intentOpen = objContext.State.IsOpen;

        // If closing and we have a pending show timer, cancel it immediately
        if (!intentOpen && objShowTimer != null)
        {
            CancelTimers();
            return;
        }

        if (intentOpen != objState.Value)
        {
            // Reset context state immediately (delay will update it later)
            objContext.State.IsOpen = objState.Value;

            // Apply delay before actually opening/closing
            _ = SetOpenWithDelayAsync(intentOpen);
        }
    }

    private async Task SetOpenWithDelayAsync(bool open)
    {
        // Cancel any pending timers
        CancelTimers();

        if (open)
        {
            // Apply delay for showing
            if (DelayDuration > 0)
            {
                objShowTimer = new System.Timers.Timer(DelayDuration);
                objShowTimer.Elapsed += async (sender, e) =>
                {
                    await InvokeAsync(async () =>
                    {
                        // Update both state and context
                        objContext.State.IsOpen = true;
                        await objState.SetValueAsync(true);
                        StateHasChanged();
                    });

                    objShowTimer?.Dispose();
                    objShowTimer = null;
                };
                objShowTimer.AutoReset = false;
                objShowTimer.Start();
            }
            else
            {
                // Show immediately
                objContext.State.IsOpen = true;
                await objState.SetValueAsync(true);
                StateHasChanged();
            }
        }
        else
        {
            // Apply hide delay if configured
            if (HideDelay > 0)
            {
                objHideTimer = new System.Timers.Timer(HideDelay);
                objHideTimer.Elapsed += async (sender, e) =>
                {
                    await InvokeAsync(async () =>
                    {
                        // Update both state and context
                        objContext.State.IsOpen = false;
                        await objState.SetValueAsync(false);
                        StateHasChanged();
                    });

                    objHideTimer?.Dispose();
                    objHideTimer = null;
                };
                objHideTimer.AutoReset = false;
                objHideTimer.Start();
            }
            else
            {
                // Hide immediately
                objContext.State.IsOpen = false;
                await objState.SetValueAsync(false);
                StateHasChanged();
            }
        }
    }

    private void CancelTimers()
    {
        if (objShowTimer != null)
        {
            objShowTimer.Stop();
            objShowTimer.Dispose();
            objShowTimer = null;
        }

        if (objHideTimer != null)
        {
            objHideTimer.Stop();
            objHideTimer.Dispose();
            objHideTimer = null;
        }
    }

    public void Dispose()
    {
        if (!objDisposed)
        {
            CancelTimers();
            objContext.OnStateChanged -= HandleContextStateChanged;
            objDisposed = true;
        }
    }
}
