@namespace TrBlazeUI.Primitives.HoverCard
@implements IDisposable

@* HoverCard primitive root component - headless, unstyled behavior only *@
<CascadingValue Value="@objContext" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    private HoverCardContext objContext = new();
    private UseControllableState<bool> objState = null!;

    /// <summary>
    /// The child content to render within the hover card context.
    /// Typically includes HoverCardTrigger and HoverCardContent.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Controls whether the hover card is open (controlled mode).
    /// When null, the hover card manages its own state (uncontrolled mode).
    /// </summary>
    [Parameter]
    public bool? Open { get; set; }

    /// <summary>
    /// Event callback invoked when the open state changes.
    /// Use with @bind-Open for two-way binding.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// Default open state when in uncontrolled mode.
    /// </summary>
    [Parameter]
    public bool DefaultOpen { get; set; } = false;

    /// <summary>
    /// Event callback invoked when the hover card open state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnOpenChange { get; set; }

    /// <summary>
    /// Delay in milliseconds before opening the hover card.
    /// Default is 700ms.
    /// </summary>
    [Parameter]
    public int OpenDelay { get; set; } = 700;

    /// <summary>
    /// Delay in milliseconds before closing the hover card.
    /// Default is 300ms.
    /// </summary>
    [Parameter]
    public int CloseDelay { get; set; } = 300;

    protected override void OnInitialized()
    {
        // Initialize controllable state
        objState = new UseControllableState<bool>(DefaultOpen)
        {
            ControlledValue = Open ?? DefaultOpen,
            OnValueChanged = OpenChanged,
            IsControlled = OpenChanged.HasDelegate
        };

        // Sync initial state to context
        objContext.State.IsOpen = objState.Value;
        objContext.State.OpenDelay = OpenDelay;
        objContext.State.CloseDelay = CloseDelay;

        // Subscribe to context state changes
        objContext.OnStateChanged += HandleContextStateChanged;
    }

    protected override void OnParametersSet()
    {
        // Update controlled value if it changed
        if (objState.IsControlled && Open.HasValue && Open.Value != objState.ControlledValue)
        {
            objState.ControlledValue = Open.Value;
            objContext.State.IsOpen = Open.Value;
        }

        // Update delays
        objContext.State.OpenDelay = OpenDelay;
        objContext.State.CloseDelay = CloseDelay;
    }

    private void HandleContextStateChanged()
    {
        // When context state changes (e.g., from HoverCardTrigger),
        // update the controllable state
        var newOpenState = objContext.State.IsOpen;

        if (objState.Value != newOpenState)
        {
            _ = objState.SetValueAsync(newOpenState);

            // Invoke additional callback if provided
            if (OnOpenChange.HasDelegate)
            {
                _ = OnOpenChange.InvokeAsync(newOpenState);
            }

            StateHasChanged();
        }
    }

    public void Dispose()
    {
        objContext.OnStateChanged -= HandleContextStateChanged;
    }

    /// <summary>
    /// Gets or sets additional HTML attributes.
    /// </summary>
    /// <remarks>
    /// This component renders no element of its own - it only supplies a cascading context - so
    /// the attributes are accepted (never throwing) but are not emitted. Put the attribute on the
    /// component that renders the visible element instead.
    /// </remarks>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
