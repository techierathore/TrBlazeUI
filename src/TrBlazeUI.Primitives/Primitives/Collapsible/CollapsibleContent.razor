@namespace TrBlazeUI.Primitives.Collapsible

@* CollapsibleContent primitive - collapsible content region *@
@if (objShouldRender)
{
    <div role="region"
         data-state="@(Context?.Open ?? false ? "open" : "closed")"
         aria-hidden="@((Context?.Open ?? false) ? "false" : "true")"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}
