@namespace TrBlazeUI.Primitives.Popover
@using TrBlazeUI.Primitives.Utilities

@* Popover trigger - opens the popover when clicked *@
@if (AsChild)
{
    @* When AsChild is true, pass trigger context to child for it to handle *@
    <CascadingValue Value="TriggerContext" Name="TriggerContext">
        @ChildContent
    </CascadingValue>
}
else
{
    <button type="button"
            id="@Context.TriggerId"
            @ref="@objTriggerRef"
            @onclick="HandleClick"
            @onkeydown="HandleKeyDownAsync"
            @attributes="AdditionalAttributes"
            aria-haspopup="true"
            aria-expanded="@Context.IsOpen.ToString().ToLower()"
            aria-controls="@Context.ContentId"
            style="@(Context.IsOpen ? "pointer-events: none;" : "")">
        @ChildContent
    </button>
}

@code {
    [CascadingParameter]
    private PopoverContext Context { get; set; } = null!;

    private ElementReference objTriggerRef;

    /// <summary>
    /// The content to display inside the trigger button.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// When true, the trigger does not render its own button element.
    /// Instead, it passes trigger behavior via TriggerContext to child components.
    /// The child component must consume TriggerContext and apply click/aria behavior.
    /// </summary>
    [Parameter]
    public bool AsChild { get; set; } = false;

    /// <summary>
    /// Additional attributes to apply to the trigger button element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Custom click handler. If provided, this is called in addition to the default toggle behavior.
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// Whether to use custom click handling. When true, only OnClick is invoked.
    /// Default is false (popover opens on click).
    /// </summary>
    [Parameter]
    public bool CustomClickHandling { get; set; } = false;

    /// <summary>
    /// Stores the trigger element reference when using AsChild pattern.
    /// </summary>
    private ElementReference? objAsChildTriggerRef;

    /// <summary>
    /// Context passed to child components when AsChild is true.
    /// </summary>
    private TriggerContext TriggerContext => new()
    {
        TriggerId = Context.TriggerId,
        IsOpen = Context.IsOpen,
        // A second click on an AsChild trigger closes the popover. The trigger's own button gets the
        // same result through pointer-events:none while open (the click lands outside and the
        // click-outside handler closes it); an AsChild child, such as DatePicker's Button, keeps its
        // pointer events, and its second click used to do nothing at all (Sevak TR-050).
        Toggle = () =>
        {
            if (Context.IsOpen)
            {
                Context.Close();
            }
            else
            {
                Context.Open(objAsChildTriggerRef);
            }
        },
        Open = () => Context.Open(objAsChildTriggerRef),
        Close = () => Context.Close(),
        AriaHasPopup = "true",
        AriaControls = Context.ContentId,
        OnKeyDown = HandleKeyDownAsync,
        SetTriggerElement = (ElementReference el) => objAsChildTriggerRef = el
    };

    private async Task HandleClick(MouseEventArgs args)
    {
        // IMPORTANT: Only OPEN the popover from the trigger, never close it.
        // Closing is handled by click-outside detection or explicit close actions.
        // This prevents Blazor Server event routing edge cases where clicks inside
        // the popover content can incorrectly trigger the trigger's click handler
        // during component re-renders.
        if (Context.IsOpen)
        {
            return;
        }

        if (CustomClickHandling && OnClick.HasDelegate)
        {
            // Custom handling only
            await OnClick.InvokeAsync(args);
        }
        else
        {
            // Default: open popover and store trigger element for positioning
            Context.Open(objTriggerRef);

            // Also invoke custom handler if provided
            if (OnClick.HasDelegate)
            {
                await OnClick.InvokeAsync(args);
            }
        }
    }

    /// <summary>
    /// Closes the open popover when Escape is pressed on the trigger itself.
    /// </summary>
    /// <param name="aArgs">The key pressed.</param>
    /// <returns>A completed task.</returns>
    /// <remarks>
    /// Opening a popover with a click leaves the focus on its trigger, and the content's own
    /// Escape handler only hears keys pressed inside the content, so Escape did nothing until the
    /// user tabbed into it (Sevak TR-050). The content's <c>CloseOnEscape</c> is honoured here too.
    /// </remarks>
    private Task HandleKeyDownAsync(KeyboardEventArgs aArgs)
    {
        if (aArgs.Key == "Escape" && Context.IsOpen && Context.CloseOnEscape)
        {
            Context.Close();
        }

        return Task.CompletedTask;
    }

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException(
                "PopoverTrigger must be used within a Popover component. " +
                "Ensure PopoverTrigger is a child of a Popover component.");
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Proactively set the trigger element reference so it's available
        // even when the popover is opened programmatically (via @bind-Open)
        // This runs after every render to ensure the reference stays current
        if (!AsChild)
        {
            Context.SetTriggerElement(objTriggerRef);
        }
        else if (objAsChildTriggerRef.HasValue)
        {
            // When using AsChild pattern, the child component (e.g., Button) sets
            // objAsChildTriggerRef via TriggerContext.SetTriggerElement. We need to
            // propagate this to the context so Content can position relative to it.
            Context.SetTriggerElement(objAsChildTriggerRef.Value);
        }
    }
}
