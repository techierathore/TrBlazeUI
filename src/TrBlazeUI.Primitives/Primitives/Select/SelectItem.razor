@typeparam TValue
@namespace TrBlazeUI.Primitives.Select
@implements IDisposable

@* SelectItem primitive - headless selectable option *@
@if (objContext != null)
{
    <div id="@ItemId"
         role="option"
         aria-selected="@IsSelected.ToString().ToLower()"
         data-state="@(IsSelected ? "checked" : "unchecked")"
         data-focused="@(IsFocused ? "true" : null)"
         data-disabled="@(Disabled ? "true" : null)"
         @onclick="HandleClick"
         @onclick:stopPropagation="true"
         @onmouseenter="HandleMouseEnter"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter]
    private SelectContext<TValue>? objContext { get; set; }

    private int objItemIndex = -1;

    /// <summary>
    /// The value this item represents.
    /// </summary>
    [Parameter, EditorRequired]
    public TValue? Value { get; set; }

    /// <summary>
    /// Optional display text. If not provided, ChildContent is used.
    /// </summary>
    [Parameter]
    public string? TextValue { get; set; }

    /// <summary>
    /// Whether this item is disabled and cannot be selected.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Content to render for this item.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional attributes to be applied to the item element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ItemId => objContext != null ? $"{objContext.ContentId}-item-{objItemIndex}" : "";

    private bool IsSelected
    {
        get
        {
            if (objContext == null) return false;

            if (objContext.Value == null && Value == null)
                return true;

            return EqualityComparer<TValue?>.Default.Equals(objContext.Value, Value);
        }
    }

    private bool IsFocused => objContext != null && objContext.FocusedIndex == objItemIndex;

    protected override void OnInitialized()
    {
        if (objContext == null) return;

        // Get display text - either from TextValue parameter or fallback to Value string
        var displayText = TextValue ?? Value?.ToString();

        // Register this item with the context for keyboard navigation
        objItemIndex = objContext.RegisterItem(Value, Disabled, displayText);

        // Subscribe to state changes to update focus
        objContext.OnStateChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        StateHasChanged();
    }

    private void HandleClick()
    {
        if (objContext == null || Disabled || objContext.Disabled) return;

        // Get display text - either from TextValue parameter or render ChildContent to string
        var displayText = TextValue ?? Value?.ToString();

        objContext.SelectValue(Value, displayText);
    }

    private void HandleMouseEnter()
    {
        if (objContext == null) return;

        // Update focused index on mouse hover for better UX
        if (!Disabled && !objContext.Disabled)
        {
            objContext.SetFocusedIndex(objItemIndex);
        }
    }

    public void Dispose()
    {
        if (objContext != null)
        {
            objContext.OnStateChanged -= HandleStateChanged;
        }
        // Note: We don't unregister the item here as it could mess up indices
        // The context will be recreated when the select is reopened
    }
}
