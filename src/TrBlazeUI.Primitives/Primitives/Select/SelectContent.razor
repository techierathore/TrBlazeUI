@typeparam TValue
@namespace TrBlazeUI.Primitives.Select
@using TrBlazeUI.Primitives.Floating
@using TrBlazeUI.Primitives.Services
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    SelectContent primitive - headless dropdown container.
    Uses FloatingPortal for portal/positioning infrastructure.
    Maintains Select-specific behavior: keyboard navigation, item focus, ARIA attributes.
*@

@if (objContext?.IsOpen == true)
{
    <FloatingPortal IsOpen="true"
                    AnchorElement="@objContext.State.TriggerElement"
                    PortalId="@objPortalId"
                    Side="@Side"
                    Align="@Align"
                    Offset="@Offset"
                    MatchAnchorWidth="@MatchTriggerWidth"
                    Strategy="fixed"
                    ZIndex="9999"
                    OnReady="@HandleFloatingReady">
        @RenderSelectListbox()
    </FloatingPortal>
}
else
{
    @* The items are still instantiated while the listbox is closed so each one can register its
       Value/Text pair with the context - that is what lets SelectValue show the selected item's
       text on FIRST paint instead of the raw bound value. A closed SelectItem renders no markup,
       so this contributes nothing to the DOM. *@
    @ChildContent
}

@code {
    [CascadingParameter]
    private SelectContext<TValue>? objContext { get; set; }

    private IJSObjectReference? objJsModule;
    private IJSObjectReference? objClickOutsideModule;
    private IJSObjectReference? objClickOutsideCleanup;
    private DotNetObjectReference<SelectContent<TValue>>? objDotNetRef;
    private bool objIsKeyboardSetup = false;
    private string objPortalId = "";

    /// <summary>
    /// Content to render inside the select dropdown.
    /// Typically contains SelectItem components.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional attributes to be applied to the content container.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Preferred side for positioning.
    /// Default is Bottom.
    /// </summary>
    [Parameter]
    public PopoverSide Side { get; set; } = PopoverSide.Bottom;

    /// <summary>
    /// Alignment relative to trigger.
    /// Default is Start.
    /// </summary>
    [Parameter]
    public PopoverAlign Align { get; set; } = PopoverAlign.Start;

    /// <summary>
    /// Offset distance from the trigger element in pixels.
    /// Default is 4.
    /// </summary>
    [Parameter]
    public int Offset { get; set; } = 4;

    /// <summary>
    /// Whether the select content should match the trigger width.
    /// Default is true (common pattern for selects).
    /// </summary>
    [Parameter]
    public bool MatchTriggerWidth { get; set; } = true;

    protected override void OnInitialized()
    {
        if (objContext == null)
        {
            throw new InvalidOperationException(
                "SelectContent must be used within a Select component. " +
                "Ensure SelectContent is a child of a Select component.");
        }

        objPortalId = $"select-portal-{objContext.ContentId}";

        // Subscribe to context state changes for cleanup
        objContext.OnStateChanged += HandleContextStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && objJsModule == null)
        {
            objJsModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/TrBlazeUI.Primitives/js/primitives/select.js");
        }
    }

    private RenderFragment RenderSelectListbox() => builder =>
    {
        // Re-cascade the SelectContext through the portal so SelectItem components can access it
        builder.OpenComponent<CascadingValue<SelectContext<TValue>>>(0);
        builder.AddAttribute(1, "Value", objContext);
        builder.AddAttribute(2, "IsFixed", false);
        builder.AddAttribute(3, "ChildContent", (RenderFragment)(contentBuilder =>
        {
            contentBuilder.OpenElement(0, "div");
            contentBuilder.AddAttribute(1, "id", objContext!.ContentId);
            contentBuilder.AddAttribute(2, "role", "listbox");
            contentBuilder.AddAttribute(3, "aria-labelledby", objContext.TriggerId);
            contentBuilder.AddAttribute(4, "aria-activedescendant", GetActiveDescendantId());
            contentBuilder.AddAttribute(5, "data-select-content", "true");
            contentBuilder.AddAttribute(6, "tabindex", "-1");
            contentBuilder.AddMultipleAttributes(7, AdditionalAttributes);
            contentBuilder.AddContent(8, ChildContent);
            contentBuilder.CloseElement();
        }));
        builder.CloseComponent();
    };

    private async Task HandleFloatingReady()
    {
        if (objContext == null || objJsModule == null) return;

        // CRITICAL: Scroll to selected item FIRST, before any awaits.
        // This ensures the scroll position is set before the rAF visibility callback
        // from FloatingPortal's ApplyPositionAsync can paint the visible content.
        var selectedValue = objContext.State.Value?.ToString();
        await objJsModule.InvokeVoidAsync("focusInitialOption", objContext.ContentId, selectedValue);

        // Focus the selected item or first item (updates Blazor state)
        objContext.FocusSelectedOrFirst();

        // Set up click-outside detection
        await SetupClickOutsideAsync();

        // Set up JavaScript-based keyboard navigation
        if (!objIsKeyboardSetup)
        {
            objDotNetRef = DotNetObjectReference.Create(this);
            await objJsModule.InvokeVoidAsync("setupKeyboardNavigation", objContext.ContentId, objDotNetRef);
            objIsKeyboardSetup = true;
        }
    }

    private async Task SetupClickOutsideAsync()
    {
        if (objContext == null) return;

        try
        {
            objClickOutsideModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/TrBlazeUI.Primitives/js/primitives/click-outside.js");

            if (objDotNetRef == null)
            {
                objDotNetRef = DotNetObjectReference.Create(this);
            }

            // Use ID-based lookup instead of ElementReference
            objClickOutsideCleanup = await objClickOutsideModule.InvokeAsync<IJSObjectReference>(
                "onClickOutsideByIds",
                objContext.ContentId,      // Element ID (not ElementReference)
                objDotNetRef,
                "HandleClickOutside",
                objContext.TriggerId);     // Trigger ID (not ElementReference)
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to set up click-outside: {ex.Message}");
        }
    }

    private async void HandleContextStateChanged()
    {
        // When context closes, clean up
        if (objContext?.IsOpen == false && objIsKeyboardSetup)
        {
            await InvokeAsync(async () =>
            {
                await CleanupSelectAsync();
                StateHasChanged();
            });
        }
    }

    private string? GetActiveDescendantId()
    {
        if (objContext != null && objContext.FocusedIndex >= 0)
        {
            return $"{objContext.ContentId}-item-{objContext.FocusedIndex}";
        }
        return null;
    }

    private async Task CleanupSelectAsync()
    {
        // Clean up keyboard navigation
        if (objJsModule != null && objContext != null && objIsKeyboardSetup)
        {
            try
            {
                await objJsModule.InvokeVoidAsync("cleanupKeyboardNavigation", objContext.ContentId);
            }
            catch
            {
                // JS module may be disposed
            }
            objIsKeyboardSetup = false;
        }

        // Clean up click-outside listener
        if (objClickOutsideCleanup != null)
        {
            try
            {
                await objClickOutsideCleanup.InvokeVoidAsync("dispose");
                await objClickOutsideCleanup.DisposeAsync();
            }
            catch
            {
                // Cleanup may already be disposed
            }
            objClickOutsideCleanup = null;
        }
    }

    /// <summary>
    /// Called from JavaScript when clicking outside the select.
    /// </summary>
    [JSInvokable]
    public void HandleClickOutside()
    {
        objContext?.Close();
    }

    /// <summary>
    /// Called from JavaScript when the Escape key is pressed.
    /// </summary>
    [JSInvokable]
    public void HandleEscapeKey()
    {
        objContext?.Close();
    }

    /// <summary>
    /// Called from JavaScript when the Tab key is pressed.
    /// </summary>
    [JSInvokable]
    public void HandleTabKey()
    {
        objContext?.Close();
    }

    public async ValueTask DisposeAsync()
    {
        if (objContext != null)
        {
            objContext.OnStateChanged -= HandleContextStateChanged;
        }

        await CleanupSelectAsync();

        if (objClickOutsideModule != null)
        {
            await objClickOutsideModule.DisposeAsync();
        }

        if (objJsModule != null)
        {
            await objJsModule.DisposeAsync();
        }

        objDotNetRef?.Dispose();
    }
}
