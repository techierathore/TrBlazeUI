<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet Package Configuration -->
    <PackageId>TrBlazeUI.Icons.Heroicons</PackageId>
    <RootNamespace>TrBlazeUI.Icons.Heroicons</RootNamespace>
    <AssemblyName>TrBlazeUI.Icons.Heroicons</AssemblyName>
    <Description>Heroicons icon library for TrBlazeUI - 1,288 beautiful icons across 4 variants (outline, solid, mini, micro) for Blazor applications.</Description>
    <PackageTags>blazor;icons;heroicons;shadcn;svg;ui;components;blazor-components;tailwind</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- <PackageIcon>icon.png</PackageIcon> -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>TrBlazeUI Contributors</Authors>
    <Copyright>Copyright (c) 2025-present TrBlazeUI Contributors</Copyright>

  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
