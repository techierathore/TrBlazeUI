@namespace TrBlazeUI.Icons.Heroicons.Components

@if (!string.IsNullOrEmpty(SvgContent))
{
    @if (IsOutline)
    {
        @* Outline variant: stroke-based with stroke attributes *@
        <svg
            width="@ComputedSize"
            height="@ComputedSize"
            viewBox="@ViewBox"
            fill="@Fill"
            stroke="@Stroke"
            stroke-width="@ComputedStrokeWidth"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="@CssClass"
            role="@IconRole"
            aria-label="@AriaLabel"
            aria-hidden="@AriaHiddenValue"
            @attributes="AdditionalAttributes">
            @((MarkupString)SvgContent)
        </svg>
    }
    else
    {
        @* Solid/Mini/Micro variants: filled with no stroke *@
        <svg
            width="@ComputedSize"
            height="@ComputedSize"
            viewBox="@ViewBox"
            fill="@Fill"
            class="@CssClass"
            role="@IconRole"
            aria-label="@AriaLabel"
            aria-hidden="@AriaHiddenValue"
            @attributes="AdditionalAttributes">
            @((MarkupString)SvgContent)
        </svg>
    }
}
else
{
    @* Unknown icon id: render a size-preserving, screen-reader-silent placeholder
       (never a warning glyph that could be mistaken for real content); a one-time
       logger warning identifies the bad Name for the developer. *@
    <span aria-hidden="true"
          data-trblazeui-missing-icon="@Name"
          class="@CssClass"
          style="display:inline-block;width:@(ComputedSize)px;height:@(ComputedSize)px;vertical-align:middle;"></span>
}
